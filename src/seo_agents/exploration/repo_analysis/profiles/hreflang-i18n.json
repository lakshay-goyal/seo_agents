{
  "$schema": "./schema.json",
  "name": "hreflang-i18n",
  "signals": [
    {
      "id": "i18n-config",
      "label": "Locale configuration",
      "regex": "\\bi18n\\s*:\\s*\\{|\\blocales\\s*:\\s*\\[|defaultLocale\\s*:|^\\[languages\\]|defaultContentLanguage|LANGUAGES\\s*=|config\\.i18n\\.|available_locales",
      "block": true,
      "languages": [
        "@scripts",
        "@data",
        "python",
        "ruby",
        "php"
      ],
      "precision": "medium",
      "examples": {
        "match": [
          "i18n: {",
          "locales: ['en', 'fr']",
          "defaultLocale: 'en'",
          "[languages]"
        ],
        "no_match": [
          "const i18nKey = 1"
        ]
      }
    },
    {
      "id": "i18n-library",
      "label": "i18n library usage",
      "regex": "from\\s+['\\\"](?:next-intl|next-i18next|react-i18next|i18next|vue-i18n|@nuxtjs/i18n|svelte-i18n|@angular/localize|@ngx-translate/core|astro-i18next|paraglide[\\w/-]*|@lingui/[\\w-]+|react-intl)['\\\"]|\\bgettext\\s*\\(|\\b_\\(\\s*['\\\"]|\\bI18n\\.t\\s*\\(|\\b(?:__|_e|_x|esc_html__|esc_html_e|esc_attr__)\\(\\s*['\\\"]|@lang\\s*\\(|\\btrans\\s*\\(\\s*['\\\"]|['\\\"][\\w.\\-]+['\\\"]\\s*\\|\\s*t\\b|\\{%\\s*trans\\b",
      "languages": [
        "@templates",
        "@server"
      ],
      "precision": "medium",
      "examples": {
        "match": [
          "import { useTranslation } from 'react-i18next'",
          "<?php _e('Hello', 'td'); ?>",
          "{{ 'general.title' | t }}",
          "{% trans %}Hi{% endtrans %}"
        ],
        "no_match": [
          "import x from 'react'"
        ]
      }
    },
    {
      "id": "hreflang",
      "label": "hreflang alternate",
      "regex": "hreflang|hrefLang|alternates\\s*:\\s*\\{[^}]*languages|x-default",
      "block": false,
      "languages": [
        "@templates",
        "@server",
        "server-config",
        "other"
      ],
      "precision": "high",
      "examples": {
        "match": [
          "hreflang=\"fr\"",
          "x-default"
        ],
        "no_match": [
          "href=\"/fr\""
        ]
      }
    },
    {
      "id": "html-lang",
      "label": "Document language attribute",
      "regex": "<html[^>]*\\blang\\s*=\\s*['\\\"{]?([\\w-]*)|<html[^>]*\\blanguage_attributes\\s*\\(",
      "value_group": 1,
      "languages": [
        "@markup",
        "@scripts"
      ],
      "precision": "high",
      "examples": {
        "match": [
          "<html lang=\"en\">",
          "<html <?php language_attributes(); ?>>",
          "<html lang=\"{{ request.locale.iso_code }}\">"
        ],
        "no_match": [
          "<head>"
        ]
      }
    },
    {
      "id": "locale-segment",
      "label": "Locale route segment",
      "regex": "(?:^|/)(?:\\[(?:locale|lang|lng)\\]|\\[\\[\\.\\.\\.(?:locale|lang)\\]\\]|:(?:locale|lang))(?:/|$)",
      "files_only": true,
      "precision": "high",
      "examples": {
        "match": [
          "app/[locale]/page.tsx",
          "src/routes/[lang]/+page.svelte"
        ],
        "no_match": [
          "app/about/page.tsx"
        ]
      }
    },
    {
      "id": "translation-files",
      "label": "Translation resource files",
      "regex": "(?:^|/)(?:locales?|i18n|lang|languages|translations|messages)/[\\w.-]+(?:/[\\w.-]+)*\\.(?:json|ya?ml|po|pot|ts|js)$",
      "files_only": true,
      "precision": "high",
      "examples": {
        "match": [
          "locales/en.default.json",
          "config/locales/fr.yml",
          "locale/fr/LC_MESSAGES/django.po",
          "languages/theme.pot"
        ],
        "no_match": [
          "src/lang.ts"
        ]
      }
    }
  ],
  "gaps": [
    {
      "id": "no-html-lang",
      "label": "No <html lang> found",
      "when_none_of": [
        "html-lang"
      ]
    },
    {
      "id": "no-hreflang",
      "label": "Locales configured but no hreflang alternates found",
      "when_none_of": [
        "hreflang"
      ],
      "only_if_any": [
        "i18n-config",
        "locale-segment",
        "translation-files"
      ]
    }
  ],
  "framework_agnostic": true,
  "execution_hint": "Set <html lang> from the active locale in the root layout; emit reciprocal hreflang links (and x-default) in the shared head or sitemap from the locale config; translate titles/descriptions per locale."
}
