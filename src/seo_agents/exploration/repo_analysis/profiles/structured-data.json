{
  "$schema": "./schema.json",
  "name": "structured-data",
  "signals": [
    {
      "id": "json-ld-script",
      "label": "JSON-LD script tag",
      "regex": "application/ld\\+json",
      "block": false,
      "languages": [
        "@templates"
      ],
      "precision": "high",
      "examples": {
        "match": [
          "<script type=\"application/ld+json\">"
        ],
        "no_match": [
          "application/json"
        ]
      }
    },
    {
      "id": "json-ld-helper",
      "label": "JSON-LD helper/component/composable",
      "regex": "<\\w*JsonLd\\b|<NextSeo\\b|<(?:Article|Product|FAQPage|Breadcrumb|Organization|LocalBusiness|Logo|SocialProfile)JsonLd\\b|useSchemaOrg\\s*\\(|defineOrganization|definePerson|defineWebSite|defineWebPage|from\\s+['\\\"]schema-dts['\\\"]|WithContext<|['\\\"]script:ld\\+json['\\\"]|_internal/schema\\.html|\\|\\s*structured_data\\b|\\{\\{\\s*schema\\s*\\}\\}|wpseo_schema|\\|\\s*json\\s*\\}\\}(?=[^\\n]*ld)|dangerouslySetInnerHTML\\s*=\\s*\\{\\{\\s*__html\\s*:\\s*JSON\\.stringify",
      "block": true,
      "languages": [
        "@templates"
      ],
      "precision": "high",
      "examples": {
        "match": [
          "<ArticleJsonLd title=\"x\" />",
          "useSchemaOrg([",
          "{{ product | structured_data }}",
          "<NextSeo title=\"x\" />",
          "<script dangerouslySetInnerHTML={{ __html: JSON.stringify(schema) }} />"
        ],
        "no_match": [
          "JSON.stringify(x)"
        ]
      }
    },
    {
      "id": "schema-type",
      "label": "Schema.org @type value",
      "regex": "['\"]@type['\"]\\s*:\\s*(?:['\"]([\\w]+)['\"]|\\[\\s*['\"]([\\w]+)['\"])",
      "value_group": 1,
      "languages": [
        "@templates",
        "@content",
        "@data"
      ],
      "precision": "high",
      "examples": {
        "match": [
          "\"@type\": \"Product\"",
          "\"@type\": [\"Person\", \"Author\"]"
        ],
        "no_match": [
          "\"type\": \"Product\""
        ]
      }
    },
    {
      "id": "schema-context",
      "label": "Schema.org @context",
      "regex": "['\"]@context['\"]\\s*:\\s*['\"]https?://schema\\.org",
      "ignore_case": true,
      "languages": [
        "@templates",
        "@content",
        "@data"
      ],
      "precision": "high",
      "examples": {
        "match": [
          "\"@context\": \"https://schema.org\""
        ],
        "no_match": [
          "\"context\": \"x\""
        ]
      }
    },
    {
      "id": "microdata",
      "label": "Microdata",
      "regex": "itemscope|itemtype\\s*=\\s*['\"]https?://schema\\.org/(\\w+)",
      "value_group": 1,
      "languages": [
        "@markup",
        "@scripts"
      ],
      "precision": "high",
      "examples": {
        "match": [
          "itemscope",
          "itemtype=\"https://schema.org/Product\""
        ],
        "no_match": [
          "items"
        ]
      }
    }
  ],
  "gaps": [
    {
      "id": "no-structured-data",
      "label": "No structured data found",
      "when_none_of": [
        "json-ld-script",
        "json-ld-helper",
        "schema-type",
        "microdata"
      ]
    }
  ],
  "framework_agnostic": true,
  "execution_hint": "Emit JSON-LD from the page/layout that owns the entity: WebSite + Organization/Person in the root layout, Article/Product/FAQPage/BreadcrumbList in the matching page templates, built from the same data the page renders."
}
