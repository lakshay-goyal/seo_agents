{
  "$schema": "./schema.json",
  "name": "mobile-parity",
  "signals": [
    {
      "id": "viewport",
      "label": "Viewport declaration",
      "regex": "name\\s*=\\s*['\"]viewport['\"]|export\\s+const\\s+viewport\\b|generateViewport|viewport\\s*:\\s*['\"{]",
      "block": false,
      "languages": [
        "@templates"
      ],
      "precision": "high",
      "examples": {
        "match": [
          "<meta name=\"viewport\" content=\"width=device-width\">",
          "export const viewport = {"
        ],
        "no_match": [
          "viewportWidth"
        ]
      }
    },
    {
      "id": "zoom-restricted",
      "label": "Zoom restricted (user-scalable=no / maximum-scale=1)",
      "regex": "user-scalable\\s*=\\s*(?:no|0)|maximum-scale\\s*=\\s*1(?:\\.0)?\\b|userScalable\\s*:\\s*false|maximumScale\\s*:\\s*1\\b",
      "ignore_case": true,
      "languages": [
        "@templates"
      ],
      "precision": "high",
      "examples": {
        "match": [
          "user-scalable=no",
          "maximum-scale=1"
        ],
        "no_match": [
          "maximum-scale=5"
        ]
      }
    },
    {
      "id": "responsive-images",
      "label": "Responsive images (srcset/sizes/picture)",
      "regex": "\\bsrcset\\s*=|\\bsrcSet\\s*=|\\bsizes\\s*=|<picture\\b|\\bimage_tag\\b[^}]*\\bwidths\\s*:|\\bwp_get_attachment_image\\b",
      "languages": [
        "@templates"
      ],
      "precision": "high",
      "examples": {
        "match": [
          "srcset=\"a.jpg 1x\"",
          "<picture>",
          "{{ img | image_url: width: 900 | image_tag: widths: '300, 600' }}"
        ],
        "no_match": [
          "src=\"x.jpg\""
        ]
      }
    },
    {
      "id": "media-queries",
      "label": "CSS media queries",
      "regex": "@media\\s*\\(?[^{]*(?:max|min)-width",
      "languages": [
        "@styles",
        "@templates"
      ],
      "precision": "high",
      "examples": {
        "match": [
          "@media (max-width: 600px)"
        ],
        "no_match": [
          "@media print"
        ]
      }
    },
    {
      "id": "mobile-hidden-content",
      "label": "Content hidden on small screens",
      "regex": "\\bhidden\\s+(?:sm|md|lg):(?:block|flex|grid|inline)|\\bd-none\\s+d-(?:sm|md|lg)-|\\bhidden-(?:xs|sm)\\b|\\bisMobile\\b|useMediaQuery\\s*\\(",
      "languages": [
        "@templates",
        "@styles"
      ],
      "precision": "medium",
      "examples": {
        "match": [
          "class=\"hidden md:block\"",
          "d-none d-md-block"
        ],
        "no_match": [
          "class=\"hidden\""
        ]
      }
    },
    {
      "id": "touch-icon",
      "label": "Mobile/PWA icons & manifest",
      "regex": "apple-touch-icon|rel=['\"]manifest['\"]|(?:^|/)(?:manifest|site)\\.webmanifest$|theme-color",
      "languages": [
        "@templates",
        "@data"
      ],
      "precision": "high",
      "examples": {
        "match": [
          "apple-touch-icon",
          "rel=\"manifest\""
        ],
        "no_match": [
          "favicon"
        ]
      }
    }
  ],
  "gaps": [
    {
      "id": "no-viewport",
      "label": "No viewport declaration found (some frameworks add one by default)",
      "when_none_of": [
        "viewport"
      ]
    }
  ],
  "framework_agnostic": true,
  "execution_hint": "Declare `width=device-width, initial-scale=1` once in the HTML shell/layout or viewport export without zoom limits; keep the same primary content, headings, links and structured data on mobile as desktop; use srcset/sizes for large images."
}
