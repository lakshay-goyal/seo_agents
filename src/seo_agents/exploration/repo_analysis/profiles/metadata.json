{
  "$schema": "./schema.json",
  "name": "metadata",
  "signals": [
    {
      "id": "metadata-export",
      "label": "Exported metadata object",
      "regex": "export\\s+(?:const|let)\\s+metadata\\b",
      "block": true,
      "languages": [
        "@templates"
      ],
      "precision": "high",
      "examples": {
        "match": [
          "export const metadata = {"
        ],
        "no_match": [
          "const metadata = {}"
        ]
      }
    },
    {
      "id": "metadata-generator",
      "label": "Metadata generator function",
      "regex": "export\\s+(?:async\\s+)?function\\s+generateMetadata\\b",
      "block": true,
      "languages": [
        "@templates"
      ],
      "precision": "high",
      "examples": {
        "match": [
          "export async function generateMetadata({ params }) {"
        ],
        "no_match": [
          "function generateMeta()"
        ]
      }
    },
    {
      "id": "head-component",
      "label": "Head component (next/head, Helmet, Head API)",
      "regex": "<(?:Head|Helmet|HelmetProvider|NextSeo|DefaultSeo|SEO|Seo|BaseHead|MetaTags)\\b",
      "block": true,
      "languages": [
        "@templates"
      ],
      "precision": "high",
      "examples": {
        "match": [
          "<Helmet>",
          "<Head>",
          "<NextSeo title=\"x\" />"
        ],
        "no_match": [
          "<Header>"
        ]
      }
    },
    {
      "id": "head-export",
      "label": "Exported Head/meta/links function",
      "regex": "export\\s+(?:const|function|let)\\s+(?:Head|meta|links)\\b",
      "block": true,
      "languages": [
        "@templates"
      ],
      "precision": "high",
      "examples": {
        "match": [
          "export const meta = () => [",
          "export function Head() {"
        ],
        "no_match": [
          "export const metaData = 1"
        ]
      }
    },
    {
      "id": "head-composable",
      "label": "Head composable (useHead/useSeoMeta/definePageMeta)",
      "regex": "\\b(?:useHead|useSeoMeta|useServerSeoMeta|definePageMeta|useMeta)\\s*\\(",
      "block": true,
      "languages": [
        "@templates"
      ],
      "precision": "high",
      "examples": {
        "match": [
          "useHead({",
          "useSeoMeta({"
        ],
        "no_match": [
          "useHeader("
        ]
      }
    },
    {
      "id": "head-option",
      "label": "head()/metaInfo option or app.head config",
      "regex": "\\b(?:head|metaInfo)\\s*(?:\\(\\s*\\)\\s*\\{|:\\s*\\{)",
      "block": true,
      "languages": [
        "@templates"
      ],
      "precision": "medium",
      "examples": {
        "match": [
          "head() {",
          "metaInfo: {",
          "head: {"
        ],
        "no_match": [
          "header: {"
        ]
      }
    },
    {
      "id": "svelte-head",
      "label": "<svelte:head> block",
      "regex": "<svelte:head>",
      "languages": [
        "@templates"
      ],
      "precision": "high",
      "examples": {
        "match": [
          "<svelte:head>"
        ],
        "no_match": [
          "<head>"
        ]
      }
    },
    {
      "id": "meta-service",
      "label": "Title/Meta service call",
      "regex": "\\.(?:setTitle|addTag|addTags|updateTag)\\s*\\(",
      "block": true,
      "languages": [
        "@templates"
      ],
      "precision": "medium",
      "examples": {
        "match": [
          "this.title.setTitle('x')",
          "this.meta.updateTag({"
        ],
        "no_match": [
          "setTitleCase("
        ]
      }
    },
    {
      "id": "template-block",
      "label": "Server template head block/section",
      "regex": "\\{%-?\\s*block\\s+(?:title|meta|head|description|extra_head|seo)\\b|@(?:section|yield)\\s*\\(\\s*['\\\"](?:title|description|meta)['\\\"]|content_for\\s*\\(?\\s*:(?:title|description|head)|\\b(?:set|display)_meta_tags\\b|\\{%\\s*seo\\b|\\bwp_head\\s*\\(|add_theme_support\\s*\\(\\s*['\\\"]title-tag|\\bwp_title\\s*\\(|document_title_parts|pre_get_document_title|\\{\\{-?\\s*(?:page_title|page_description|content_for_header)\\b|\\{%-?\\s*render\\s+['\\\"]meta-tags|\\{\\{-?\\s*partial\\s+\\\"(?:head|seo|meta)|\\{\\{\\s*ghost_head\\s*\\}\\}|\\{\\{\\s*meta_title\\s*\\}\\}",
      "languages": [
        "@markup",
        "@server"
      ],
      "precision": "medium",
      "examples": {
        "match": [
          "{% block title %}",
          "<?php wp_head(); ?>",
          "{{ page_title }}",
          "{{ghost_head}}",
          "{{ partial \"head.html\" . }}"
        ],
        "no_match": [
          "{% block content %}"
        ]
      }
    },
    {
      "id": "templated-title",
      "label": "Title built from template variables",
      "regex": "<title>[^<]*(?:\\{\\{|\\{%|<%|<\\?|\\{)",
      "languages": [
        "@markup",
        "@scripts"
      ],
      "precision": "medium",
      "examples": {
        "match": [
          "<title>{{ page_title }}</title>",
          "<title><?php wp_title(); ?></title>"
        ],
        "no_match": [
          "<title>Home</title>"
        ]
      }
    },
    {
      "id": "runtime-title",
      "label": "Runtime document.title / meta mutation",
      "regex": "document\\.title\\s*=|document\\.querySelector\\([^)]*meta",
      "languages": [
        "@templates"
      ],
      "precision": "high",
      "examples": {
        "match": [
          "document.title = 'x'"
        ],
        "no_match": [
          "title = x"
        ]
      }
    },
    {
      "id": "site-config",
      "label": "Site-wide metadata config (siteMetadata, site, metadataBase, baseURL)",
      "regex": "\\b(?:siteMetadata|metadataBase|siteUrl|siteURL|baseURL|baseurl|SITE_URL|site_url)\\s*[:=]|\\bsite\\s*[:=]\\s*['\\\"]https?://",
      "glob": [
        "*.config.*",
        "*config.*",
        "_config.yml",
        "_config.yaml",
        "hugo.toml",
        "hugo.yaml",
        "config.toml",
        "config.yaml",
        "settings.py",
        "*.env.example",
        "docusaurus.config.*"
      ],
      "precision": "high",
      "examples": {
        "match": [
          "site: 'https://acme.com'",
          "metadataBase: new URL(x)",
          "baseURL = 'https://x/'"
        ],
        "no_match": [
          "site: siteConfig",
          "website: true"
        ]
      }
    },
    {
      "id": "title-template",
      "label": "Title template",
      "regex": "\\b(?:titleTemplate|template)\\s*:\\s*['\"`][^'\"`]*%s",
      "block": false,
      "languages": [
        "@templates"
      ],
      "precision": "high",
      "examples": {
        "match": [
          "titleTemplate: '%s | Acme'",
          "template: '%s - Shop'"
        ],
        "no_match": [
          "template: 'x'"
        ]
      }
    }
  ],
  "gaps": [
    {
      "id": "no-description",
      "label": "No meta description declaration or API found",
      "when_none_of": [
        "metadata-export",
        "metadata-generator",
        "head-component",
        "head-export",
        "head-composable",
        "head-option",
        "svelte-head",
        "meta-service",
        "template-block",
        "@literal:description"
      ]
    }
  ],
  "framework_agnostic": true,
  "execution_hint": "Change page-specific metadata where the page's own declaration lives (metadata export, head component, composable or template block in the route file); change defaults in the layout or HTML shell. Keep one title/description per URL and use the site config (metadataBase/siteUrl) for absolute canonical/og:url values."
}
