{
  "$schema": "./schema.json",
  "name": "https-security-headers",
  "signals": [
    {
      "id": "headers-config",
      "label": "Header configuration block",
      "regex": "\\b(?:async\\s+)?headers\\s*\\(\\s*\\)|\\\"headers\\\"\\s*:\\s*\\[|\\[\\[headers\\]\\]|^\\s*Header\\s+(?:always\\s+)?set\\b|\\badd_header\\s|helmet\\s*\\(|SecurityMiddleware|secure_headers|setHeaders\\s*\\(|\\bsend_headers\\b|header\\s*\\(\\s*['\\\"](?:Strict-Transport|Content-Security|X-Frame|X-Content-Type|Referrer-Policy|Permissions-Policy)",
      "block": true,
      "languages": [
        "@scripts",
        "@data",
        "server-config",
        "other",
        "python",
        "ruby",
        "php"
      ],
      "precision": "medium",
      "examples": {
        "match": [
          "async headers() {",
          "\"headers\": [",
          "Header set X-Frame-Options DENY",
          "add_header X-Frame-Options DENY;"
        ],
        "no_match": [
          "fetch(url, { headers: { a: 1 } })"
        ]
      }
    },
    {
      "id": "hsts",
      "label": "Strict-Transport-Security",
      "regex": "(?<!http-equiv=\")(?<!http-equiv=')Strict-Transport-Security|SECURE_HSTS_SECONDS|\\bhsts\\s*[:(]|force_ssl",
      "ignore_case": true,
      "languages": [
        "@templates",
        "@server",
        "server-config",
        "other"
      ],
      "precision": "high",
      "examples": {
        "match": [
          "Strict-Transport-Security",
          "SECURE_HSTS_SECONDS = 3600"
        ],
        "no_match": [
          "transport",
          "<meta http-equiv=\"Strict-Transport-Security\" content=\"max-age=1\">"
        ]
      },
      "exclude_comments": true
    },
    {
      "id": "https-redirect",
      "label": "HTTP→HTTPS enforcement",
      "regex": "SECURE_SSL_REDIRECT|force_ssl|RewriteCond\\s+%\\{HTTPS\\}|return\\s+301\\s+https://|x-forwarded-proto|requireHTTPS|forceHttps",
      "ignore_case": true,
      "languages": [
        "@templates",
        "@server",
        "server-config",
        "other"
      ],
      "precision": "medium",
      "examples": {
        "match": [
          "SECURE_SSL_REDIRECT = True",
          "RewriteCond %{HTTPS} off"
        ],
        "no_match": [
          "redirect('/home')"
        ]
      }
    },
    {
      "id": "csp",
      "label": "Content-Security-Policy (optional; not an SEO ranking signal)",
      "regex": "Content-Security-Policy|contentSecurityPolicy|content_security_policy|CSP_DEFAULT_SRC",
      "ignore_case": true,
      "languages": [
        "@templates",
        "@server",
        "server-config",
        "other"
      ],
      "precision": "high",
      "examples": {
        "match": [
          "Content-Security-Policy"
        ],
        "no_match": [
          "content policy"
        ]
      }
    },
    {
      "id": "x-frame-options",
      "label": "X-Frame-Options / frame-ancestors (optional; not an SEO ranking signal)",
      "regex": "(?<!http-equiv=\")(?<!http-equiv=')X-Frame-Options|frame-ancestors|frameguard|X_FRAME_OPTIONS",
      "ignore_case": true,
      "languages": [
        "@templates",
        "@server",
        "server-config",
        "other"
      ],
      "precision": "high",
      "examples": {
        "match": [
          "X-Frame-Options"
        ],
        "no_match": [
          "frame",
          "<meta http-equiv=\"X-Frame-Options\" content=\"DENY\">"
        ]
      }
    },
    {
      "id": "x-content-type-options",
      "label": "X-Content-Type-Options (optional; not an SEO ranking signal)",
      "regex": "X-Content-Type-Options|noSniff|SECURE_CONTENT_TYPE_NOSNIFF",
      "ignore_case": true,
      "languages": [
        "@templates",
        "@server",
        "server-config",
        "other"
      ],
      "precision": "high",
      "examples": {
        "match": [
          "X-Content-Type-Options"
        ],
        "no_match": [
          "content-type"
        ]
      }
    },
    {
      "id": "referrer-policy",
      "label": "Referrer-Policy (optional; not an SEO ranking signal)",
      "regex": "Referrer-Policy|referrerPolicy|SECURE_REFERRER_POLICY",
      "ignore_case": true,
      "languages": [
        "@templates",
        "@server",
        "server-config",
        "other"
      ],
      "precision": "medium",
      "examples": {
        "match": [
          "Referrer-Policy"
        ],
        "no_match": [
          "referrer"
        ]
      }
    },
    {
      "id": "permissions-policy",
      "label": "Permissions-Policy (optional; not an SEO ranking signal)",
      "regex": "Permissions-Policy|permissionsPolicy|Feature-Policy",
      "ignore_case": true,
      "languages": [
        "@templates",
        "@server",
        "server-config",
        "other"
      ],
      "precision": "high",
      "examples": {
        "match": [
          "Permissions-Policy"
        ],
        "no_match": [
          "permissions"
        ]
      }
    },
    {
      "id": "insecure-url",
      "label": "Hard-coded http:// URL (mixed-content candidate)",
      "regex": "(?<![\"']@context[\"']:\\s)(?<![\"']@context[\"']:)['\"(=]http://(?!localhost|127\\.0\\.0\\.1|0\\.0\\.0\\.0|www\\.w3\\.org|schemas\\.|schema\\.org|ns\\.|purl\\.org|xmlns|ogp\\.me)[\\w.-]+",
      "languages": [
        "@templates",
        "@content",
        "@data",
        "server-config"
      ],
      "exclude_comments": true,
      "precision": "medium",
      "examples": {
        "match": [
          "src=\"http://cdn.example.com/x.js\""
        ],
        "no_match": [
          "href=\"http://localhost:3000\"",
          "xmlns=\"http://www.w3.org/2000/svg\"",
          "\"@context\": \"http://schema.org\""
        ]
      }
    }
  ],
  "gaps": [
    {
      "id": "no-hsts",
      "label": "No HSTS declaration found (may be set by the host/CDN)",
      "when_none_of": [
        "hsts"
      ]
    }
  ],
  "framework_agnostic": true,
  "execution_hint": "Add headers in the one place every response passes through: hosting config (vercel.json/netlify.toml/_headers/.htaccess/nginx) or framework headers()/middleware. Replace http:// asset and link URLs with https://."
}
