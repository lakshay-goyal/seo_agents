{
  "$schema": "./schema.json",
  "name": "rendering-strategy",
  "signals": [
    {
      "id": "csr-mount",
      "label": "Client-side root mount",
      "regex": "\\bcreateRoot\\s*\\(|ReactDOM\\.render\\s*\\(|createApp\\s*\\([^)]*\\)[\\s\\S]{0,200}?\\.mount\\s*\\(|bootstrapApplication\\s*\\(|bootstrapModule\\s*\\(|new\\s+App\\s*\\(\\s*\\{\\s*target|\\bmount\\s*\\(\\s*App|\\brender\\s*\\(\\s*\\(\\)\\s*=>",
      "mode": "CSR",
      "languages": [
        "@templates"
      ],
      "precision": "high",
      "examples": {
        "match": [
          "createRoot(document.getElementById(\"root\"))",
          "createApp(App).mount('#app')"
        ],
        "no_match": [
          "createRootNode()"
        ]
      }
    },
    {
      "id": "spa-shell",
      "label": "Empty SPA root element in HTML shell",
      "regex": "<div\\s+id=['\"](?:root|app|__next|svelte)['\"]\\s*>\\s*</div>",
      "mode": "CSR",
      "glob": [
        "*.html"
      ],
      "precision": "high",
      "examples": {
        "match": [
          "<div id=\"root\"></div>",
          "<div id=\"app\"> </div>"
        ],
        "no_match": [
          "<div id=\"root\"><h1>Hi</h1></div>"
        ]
      }
    },
    {
      "id": "hydration",
      "label": "Hydration of server HTML",
      "regex": "\\bhydrateRoot\\s*\\(|ReactDOM\\.hydrate\\s*\\(|createSSRApp\\s*\\(|provideClientHydration",
      "mode": "hydration",
      "languages": [
        "@templates"
      ],
      "precision": "high",
      "examples": {
        "match": [
          "hydrateRoot(el, <App />)",
          "createSSRApp(App)"
        ],
        "no_match": [
          "hydrate()"
        ]
      }
    },
    {
      "id": "server-render-api",
      "label": "Server rendering API / per-request data",
      "regex": "renderToString\\s*\\(|renderToPipeableStream\\s*\\(|getServerSideProps\\b|getServerData\\b|export\\s+(?:async\\s+)?(?:function|const)\\s+loader\\b|force-dynamic|output\\s*:\\s*['\"]server['\"]|@angular/ssr|provideServerRendering|\\+page\\.server|export\\s+const\\s+csr\\s*=\\s*false",
      "mode": "SSR",
      "block": false,
      "languages": [
        "@templates"
      ],
      "precision": "high",
      "examples": {
        "match": [
          "export async function getServerSideProps() {",
          "export async function loader() {"
        ],
        "no_match": [
          "function loaderSpinner()"
        ]
      }
    },
    {
      "id": "server-template",
      "label": "Server-rendered template response",
      "regex": "res\\.render\\s*\\(|render_template\\s*\\(|TemplateResponse\\s*\\(|\\brender\\s*\\(\\s*request|return\\s+view\\s*\\(|class\\s+\\w+Controller\\s*<|\\$this->render\\s*\\(",
      "mode": "SSR",
      "languages": [
        "@server"
      ],
      "precision": "high",
      "examples": {
        "match": [
          "res.render('home')",
          "return render(request, 'a.html')",
          "return view('welcome');"
        ],
        "no_match": [
          "render()"
        ]
      }
    },
    {
      "id": "static-generation",
      "label": "Static generation at build",
      "regex": "getStaticProps\\b|getStaticPaths\\b|generateStaticParams\\b|force-static|output\\s*:\\s*['\"](?:export|static)['\"]|export\\s+const\\s+prerender\\s*=\\s*(?:true|['\"]auto['\"])|adapter-static|vite-ssg|ViteSSG|react-snap|\\bprerender\\s*:\\s*true|createPages\\b|RenderMode\\.Prerender",
      "mode": "SSG",
      "languages": [
        "@templates",
        "@data"
      ],
      "precision": "high",
      "examples": {
        "match": [
          "export async function getStaticProps() {",
          "generateStaticParams",
          "export const prerender = true"
        ],
        "no_match": [
          "getStatic()"
        ]
      }
    },
    {
      "id": "isr",
      "label": "Incremental/stale-while-revalidate regeneration",
      "regex": "export\\s+const\\s+revalidate\\s*=|\\brevalidate\\s*:\\s*\\d+|\\b(?:isr|swr)\\s*:\\s*(?:true|\\d)|defer\\s*:\\s*true",
      "mode": "ISR",
      "languages": [
        "@templates"
      ],
      "precision": "medium",
      "examples": {
        "match": [
          "export const revalidate = 60",
          "revalidate: 60"
        ],
        "no_match": [
          "revalidatePath(x)"
        ]
      }
    },
    {
      "id": "hybrid",
      "label": "Per-route rendering rules",
      "regex": "\\brouteRules\\s*:|output\\s*:\\s*['\"]hybrid['\"]",
      "mode": "hybrid",
      "languages": [
        "@templates"
      ],
      "precision": "high",
      "examples": {
        "match": [
          "routeRules: {",
          "output: 'hybrid'"
        ],
        "no_match": [
          "rules: {"
        ]
      }
    },
    {
      "id": "server-default",
      "label": "Route file rendered on the server/at build by framework default (App Router, SvelteKit, Astro, Nuxt, Remix, Gatsby pages)",
      "regex": "(?:^|/)app/(?:.*/)?(?:page|layout)\\.(?:tsx|jsx|ts|js|mdx)$|^src/routes/(?:.*/)?\\+(?:page|layout)\\.svelte$|^src/pages/.+\\.(?:astro|md|mdx)$|^(?:app/)?pages/.+\\.vue$|^app/routes/.+\\.(?:tsx|jsx)$",
      "mode": "server-default",
      "files_only": true,
      "precision": "high",
      "examples": {
        "match": [
          "app/page.tsx",
          "src/routes/+page.svelte",
          "src/pages/index.astro",
          "pages/index.vue"
        ],
        "no_match": [
          "src/components/Button.tsx"
        ]
      }
    },
    {
      "id": "client-only",
      "label": "Client-only component/island",
      "regex": "^\\s*['\"]use client['\"]|ssr\\s*:\\s*false|<ClientOnly\\b|client:(?:load|idle|visible|media|only)|export\\s+const\\s+ssr\\s*=\\s*false|clientLoader\\b",
      "mode": "CSR-component",
      "languages": [
        "@templates"
      ],
      "precision": "high",
      "examples": {
        "match": [
          "'use client'",
          "client:load",
          "ssr: false"
        ],
        "no_match": [
          "'use server'"
        ]
      }
    },
    {
      "id": "server-theme-template",
      "label": "Server-rendered theme/template file (Liquid, PHP, Blade, ERB, Twig, Hugo, Handlebars)",
      "regex": "(?:^|/)(?:layout|templates|sections|snippets)/[^/]+\\.liquid$|(?:^|/)(?:index|single|page|archive|front-page|home|header|footer|singular)\\.php$|\\.blade\\.php$|\\.html\\.erb$|\\.html\\.twig$|(?:^|/)layouts/_default/[^/]+\\.html$|(?:^|/)(?:default|index|post|page)\\.hbs$",
      "mode": "SSR",
      "files_only": true,
      "precision": "medium",
      "examples": {
        "match": [
          "sections/header.liquid",
          "single.php",
          "resources/views/home.blade.php",
          "layouts/_default/baseof.html"
        ],
        "no_match": [
          "src/App.tsx"
        ]
      }
    }
  ],
  "gaps": [],
  "framework_agnostic": true,
  "execution_hint": "Content that must rank should be in the initial HTML: prefer SSG/ISR for marketing/content pages, SSR for per-request data, and keep client-only components for interactivity below the fold. For pure SPAs add prerendering or migrate the affected routes to an SSR/SSG layer."
}
