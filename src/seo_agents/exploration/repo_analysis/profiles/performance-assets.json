{
  "$schema": "./schema.json",
  "name": "performance-assets",
  "signals": [
    {
      "id": "image-optimizer",
      "label": "Framework image optimizer",
      "regex": "from\\s+['\\\"](?:next/image|next/legacy/image|astro:assets|@nuxt/image|gatsby-plugin-image|@sveltejs/enhanced-img|@unpic/[\\w-]+)['\\\"]|<(?:NuxtImg|NuxtPicture|GatsbyImage|StaticImage|enhanced:img)\\b|\\bngSrc\\s*=|\\|\\s*image_url\\b|\\bthe_post_thumbnail\\s*\\(|\\bwp_get_attachment_image\\s*\\(|\\.(?:Resize|Fill|Fit)\\s+\\\"|\\bimages\\.Process\\b",
      "tags": [
        "LCP",
        "CLS"
      ],
      "languages": [
        "@templates"
      ],
      "precision": "high",
      "examples": {
        "match": [
          "import Image from 'next/image'",
          "{{ img | image_url: width: 800 }}",
          "<?php the_post_thumbnail('large'); ?>",
          "{{ $img := .Resize \"600x\" }}"
        ],
        "no_match": [
          "import Link from 'next/link'"
        ]
      }
    },
    {
      "id": "priority-image",
      "label": "Prioritised/preloaded hero image",
      "regex": "<\\w[\\w.:-]*\\b[^>]*\\spriority(?:=\\{true\\}|=['\\\"]?true['\\\"]?)?(?=[\\s/>])|fetchpriority\\s*=\\s*['\\\"]high|rel=['\\\"]preload['\\\"][^>]*as=['\\\"]image|loading\\s*=\\s*['\\\"]eager",
      "tags": [
        "LCP"
      ],
      "languages": [
        "@templates"
      ],
      "precision": "high",
      "examples": {
        "match": [
          "<Image src={hero} priority />",
          "<img fetchpriority=\"high\" src=\"h.webp\">",
          "<link rel=\"preload\" href=\"h.webp\" as=\"image\">"
        ],
        "no_match": [
          "const priority = 1",
          "// high priority task",
          "<Task priority=\"low\">"
        ]
      }
    },
    {
      "id": "font-loader",
      "label": "Font loading",
      "regex": "from\\s+['\\\"](?:next/font/[\\w]+|@fontsource[\\w/-]*)['\\\"]|@font-face|fonts\\.googleapis\\.com|use\\.typekit\\.net|\\|\\s*font_face\\b|\\bfont_url\\b",
      "tags": [
        "LCP",
        "CLS"
      ],
      "languages": [
        "@templates",
        "@styles"
      ],
      "precision": "high",
      "examples": {
        "match": [
          "@font-face {",
          "https://fonts.googleapis.com/css2?family=Inter",
          "{{ settings.type_body_font | font_face }}"
        ],
        "no_match": [
          "font-size: 12px"
        ]
      }
    },
    {
      "id": "font-display",
      "label": "font-display set",
      "regex": "font-display\\s*:|display\\s*[:=]\\s*['\"]swap|&display=swap",
      "tags": [
        "CLS"
      ],
      "languages": [
        "@templates",
        "@styles"
      ],
      "precision": "high",
      "examples": {
        "match": [
          "font-display: swap",
          "&display=swap"
        ],
        "no_match": [
          "display: flex"
        ]
      }
    },
    {
      "id": "preconnect",
      "label": "Resource hints (preconnect/dns-prefetch/preload)",
      "regex": "rel\\s*=\\s*['\"](?:preconnect|dns-prefetch|preload|modulepreload)['\"]",
      "tags": [
        "LCP",
        "TTFB"
      ],
      "languages": [
        "@templates"
      ],
      "precision": "high",
      "examples": {
        "match": [
          "rel=\"preconnect\"",
          "rel='dns-prefetch'"
        ],
        "no_match": [
          "rel=\"stylesheet\""
        ]
      }
    },
    {
      "id": "third-party-script",
      "label": "Third-party script",
      "regex": "<script[^>]+src=['\"]https?://[^'\"]+['\"][^>]*>|googletagmanager\\.com|google-analytics\\.com|gtag\\s*\\(|connect\\.facebook\\.net|hotjar|clarity\\.ms|intercom|segment\\.com|cdn\\.jsdelivr|unpkg\\.com",
      "tags": [
        "INP",
        "LCP"
      ],
      "ignore_case": true,
      "languages": [
        "@templates",
        "@server"
      ],
      "exclude_comments": true,
      "precision": "medium",
      "examples": {
        "match": [
          "<script src=\"https://cdn.example.com/a.js\"></script>",
          "googletagmanager.com"
        ],
        "no_match": [
          "<script src=\"/app.js\"></script>"
        ]
      }
    },
    {
      "id": "script-strategy",
      "label": "Script loading strategy (async/defer/next/script/Partytown)",
      "regex": "<script[^>]*\\b(?:async|defer)\\b|strategy\\s*=\\s*['\"](?:lazyOnload|afterInteractive|worker)|partytown|from\\s+['\"]next/script['\"]",
      "tags": [
        "INP",
        "LCP"
      ],
      "languages": [
        "@templates"
      ],
      "precision": "high",
      "examples": {
        "match": [
          "<script defer src=\"a.js\">",
          "strategy=\"lazyOnload\""
        ],
        "no_match": [
          "<script src=\"a.js\">"
        ]
      }
    },
    {
      "id": "code-splitting",
      "label": "Code splitting / dynamic import",
      "regex": "\\bimport\\s*\\(\\s*['\"`]|React\\.lazy\\s*\\(|defineAsyncComponent|loadChildren\\s*:|next/dynamic",
      "tags": [
        "INP",
        "LCP"
      ],
      "languages": [
        "@templates"
      ],
      "precision": "medium",
      "examples": {
        "match": [
          "import('./Chart')",
          "loadChildren: () => x"
        ],
        "no_match": [
          "import x from './Chart'"
        ]
      }
    },
    {
      "id": "vitals-measurement",
      "label": "Web vitals measurement",
      "regex": "from\\s+['\"]web-vitals['\"]|reportWebVitals|useReportWebVitals|@vercel/speed-insights|SpeedInsights|onLCP\\s*\\(|onCLS\\s*\\(|onINP\\s*\\(",
      "tags": [
        "LCP",
        "CLS",
        "INP",
        "TTFB"
      ],
      "languages": [
        "@templates"
      ],
      "precision": "high",
      "examples": {
        "match": [
          "from 'web-vitals'",
          "reportWebVitals"
        ],
        "no_match": [
          "vitals"
        ]
      }
    },
    {
      "id": "caching-compression",
      "label": "Caching/compression config",
      "regex": "Cache-Control|max-age=\\d|\\bcompression\\s*\\(|\\bgzip\\s+on\\b|\\bbrotli\\b|compress\\s*:\\s*true|ExpiresByType",
      "tags": [
        "TTFB"
      ],
      "ignore_case": true,
      "languages": [
        "@scripts",
        "@data",
        "server-config",
        "other",
        "python",
        "ruby",
        "php"
      ],
      "precision": "medium",
      "examples": {
        "match": [
          "Cache-Control: public, max-age=31536000",
          "gzip on;"
        ],
        "no_match": [
          "import { Map } from 'immutable'"
        ]
      }
    },
    {
      "id": "css-in-js-runtime",
      "label": "Runtime CSS-in-JS",
      "regex": "from\\s+['\"](?:styled-components|@emotion/(?:react|styled))['\"]",
      "tags": [
        "INP",
        "LCP"
      ],
      "languages": [
        "@templates"
      ],
      "precision": "high",
      "examples": {
        "match": [
          "import styled from 'styled-components'"
        ],
        "no_match": [
          "import './a.css'"
        ]
      }
    },
    {
      "id": "animation-heavy",
      "label": "Scroll/animation library on main thread",
      "regex": "from\\s+['\"](?:aos|gsap|framer-motion|animejs|lottie-web|locomotive-scroll)['\"]|AOS\\.init",
      "tags": [
        "INP",
        "CLS"
      ],
      "languages": [
        "@templates"
      ],
      "precision": "high",
      "examples": {
        "match": [
          "import { motion } from 'framer-motion'",
          "AOS.init()"
        ],
        "no_match": [
          "import x from 'react'"
        ]
      }
    }
  ],
  "gaps": [
    {
      "id": "no-vitals-measurement",
      "label": "No web vitals measurement found",
      "when_none_of": [
        "vitals-measurement"
      ]
    },
    {
      "id": "no-font-display",
      "label": "Fonts loaded but no font-display/swap found",
      "when_none_of": [
        "font-display"
      ],
      "only_if_any": [
        "font-loader"
      ]
    }
  ],
  "framework_agnostic": true,
  "execution_hint": "LCP: preload/prioritise the hero image, serve modern formats, inline critical CSS. CLS: width/height or aspect-ratio on every image/embed, font-display: swap with size-adjusted fallbacks. INP: defer third-party scripts, split large bundles, remove heavy client libraries. TTFB: cache static output and enable compression in hosting config."
}
