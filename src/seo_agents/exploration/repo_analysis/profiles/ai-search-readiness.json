{
  "$schema": "./schema.json",
  "name": "ai-search-readiness",
  "signals": [
    {
      "id": "llms-txt",
      "label": "llms.txt / llms-full.txt",
      "regex": "(?:^|/)llms(?:-full)?\\.txt$",
      "files_only": true,
      "precision": "high",
      "examples": {
        "match": [
          "public/llms.txt",
          "llms-full.txt"
        ],
        "no_match": [
          "docs/llms.md"
        ]
      }
    },
    {
      "id": "ai-crawler-rule",
      "label": "AI crawler rule",
      "regex": "GPTBot|ChatGPT-User|OAI-SearchBot|ClaudeBot|Claude-Web|anthropic-ai|PerplexityBot|Google-Extended|CCBot|Bytespider|Applebot-Extended|Amazonbot|meta-externalagent",
      "ignore_case": true,
      "languages": [
        "text",
        "@scripts",
        "python",
        "ruby",
        "php",
        "liquid",
        "server-config",
        "@data"
      ],
      "precision": "high",
      "examples": {
        "match": [
          "User-agent: GPTBot",
          "{ userAgent: 'ClaudeBot', disallow: '/' }"
        ],
        "no_match": [
          "User-agent: Googlebot"
        ]
      }
    },
    {
      "id": "faq-schema",
      "label": "FAQ/HowTo/QA schema",
      "regex": "['\"]@type['\"]\\s*:\\s*['\"](FAQPage|HowTo|QAPage|Question)['\"]",
      "value_group": 1,
      "languages": [
        "@templates",
        "@content",
        "@data"
      ],
      "precision": "high",
      "examples": {
        "match": [
          "\"@type\": \"FAQPage\""
        ],
        "no_match": [
          "\"@type\": \"Article\""
        ]
      }
    },
    {
      "id": "faq-section",
      "label": "FAQ section",
      "regex": "\\bFAQs?\\b|frequently\\s+asked\\s+questions|<(?:section|div|ul|dl)\\b[^>]*(?:id|class(?:Name)?)\\s*=\\s*['\\\"][^'\\\"]*\\bfaqs?\\b",
      "ignore_case": true,
      "languages": [
        "@templates",
        "@content"
      ],
      "precision": "medium",
      "exclude_comments": true,
      "examples": {
        "match": [
          "<h2>Frequently asked questions</h2>",
          "<section class=\"faq-list\">",
          "## FAQ"
        ],
        "no_match": [
          "<details><summary>More</summary></details>",
          "<Accordion items={x} />"
        ]
      }
    },
    {
      "id": "question-heading",
      "label": "Question-style heading",
      "regex": "<h[2-4][^>]*>\\s*(?:what|how|why|when|where|who|which|can|does|is|are|should)\\b[^<]{3,}\\?\\s*</h[2-4]>|^#{2,4}\\s+(?:What|How|Why|When|Where|Who|Which|Can|Does|Is|Are|Should)\\b.*\\?\\s*$",
      "ignore_case": true,
      "languages": [
        "@templates",
        "@content"
      ],
      "precision": "medium",
      "examples": {
        "match": [
          "<h2>What is jasmine tea?</h2>",
          "## How do I order?"
        ],
        "no_match": [
          "<h2>Our story</h2>"
        ]
      }
    },
    {
      "id": "summary-block",
      "label": "Summary/TL;DR/key takeaways block",
      "regex": "TL;?DR|key\\s+takeaways|in\\s+summary|at\\s+a\\s+glance",
      "ignore_case": true,
      "languages": [
        "@templates",
        "@content"
      ],
      "precision": "low",
      "examples": {
        "match": [
          "Key takeaways",
          "TL;DR"
        ],
        "no_match": [
          "<p>Summary</p>"
        ]
      }
    },
    {
      "id": "semantic-landmark",
      "label": "Semantic landmark element",
      "regex": "<(?:main|article|section|aside|nav|header|footer)\\b",
      "languages": [
        "@templates"
      ],
      "precision": "high",
      "examples": {
        "match": [
          "<main class=\"x\">",
          "<article>"
        ],
        "no_match": [
          "<mainframe>",
          "<div>"
        ]
      }
    },
    {
      "id": "list-table",
      "label": "Lists/tables (extractable structure)",
      "regex": "<(?:ol|ul|table|dl)\\b|^\\s*\\|.+\\|\\s*$",
      "languages": [
        "@templates",
        "@content"
      ],
      "precision": "high",
      "examples": {
        "match": [
          "<ul>",
          "| a | b |"
        ],
        "no_match": [
          "<p>"
        ]
      }
    },
    {
      "id": "dates",
      "label": "Published/updated dates",
      "regex": "datePublished|dateModified|article:published_time|article:modified_time|<time\\b|^(?:date|updated|lastmod|published):",
      "ignore_case": true,
      "languages": [
        "@templates",
        "@content",
        "@data"
      ],
      "precision": "medium",
      "examples": {
        "match": [
          "datePublished",
          "<time datetime=\"2024-01-01\">",
          "date: 2024-01-01"
        ],
        "no_match": [
          "updatedAt: x"
        ]
      }
    }
  ],
  "gaps": [
    {
      "id": "no-llms-txt",
      "label": "No llms.txt found",
      "when_none_of": [
        "llms-txt"
      ]
    },
    {
      "id": "no-ai-crawler-policy",
      "label": "No explicit AI crawler policy in robots",
      "when_none_of": [
        "ai-crawler-rule"
      ]
    },
    {
      "id": "no-faq-schema",
      "label": "FAQ content found but no FAQPage schema",
      "when_none_of": [
        "faq-schema"
      ],
      "only_if_any": [
        "faq-section",
        "question-heading"
      ]
    }
  ],
  "framework_agnostic": true,
  "execution_hint": "Add /llms.txt summarising key pages; decide AI crawler access explicitly in robots; phrase key H2s as questions with a direct 1-2 sentence answer below; add FAQPage schema where FAQ content exists; wrap primary content in <main>/<article>; show published/updated dates."
}
