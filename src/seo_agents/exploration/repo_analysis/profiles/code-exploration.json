{
  "$schema": "./schema.json",
  "name": "code-exploration",
  "framework_markers": {
    "Next.js": {
      "dependencies": [
        "next"
      ],
      "files": [
        "next.config.*"
      ]
    },
    "React": {
      "dependencies": [
        "react",
        "react-dom"
      ]
    },
    "Remix / React Router": {
      "dependencies": [
        "@remix-run/react",
        "@react-router/dev"
      ]
    },
    "Gatsby": {
      "dependencies": [
        "gatsby"
      ],
      "files": [
        "gatsby-config.*"
      ]
    },
    "Vue": {
      "dependencies": [
        "vue"
      ]
    },
    "Nuxt": {
      "dependencies": [
        "nuxt"
      ],
      "files": [
        "nuxt.config.*"
      ]
    },
    "Svelte / SvelteKit": {
      "dependencies": [
        "svelte",
        "@sveltejs/kit"
      ],
      "files": [
        "svelte.config.*"
      ]
    },
    "Astro": {
      "dependencies": [
        "astro"
      ],
      "files": [
        "astro.config.*"
      ]
    },
    "Angular": {
      "dependencies": [
        "@angular/core"
      ],
      "files": [
        "angular.json"
      ]
    },
    "Solid": {
      "dependencies": [
        "solid-js",
        "@solidjs/start"
      ]
    },
    "Qwik": {
      "dependencies": [
        "@builder.io/qwik"
      ]
    },
    "Eleventy": {
      "dependencies": [
        "@11ty/eleventy"
      ],
      "files": [
        ".eleventy.js",
        "eleventy.config.*"
      ]
    },
    "Hugo": {
      "files": [
        "hugo.toml",
        "hugo.yaml",
        "layouts/_default/baseof.html"
      ]
    },
    "Jekyll": {
      "dependencies": [
        "jekyll",
        "github-pages"
      ],
      "files": [
        "_config.yml"
      ]
    },
    "Docusaurus": {
      "dependencies": [
        "@docusaurus/core"
      ]
    },
    "VitePress / VuePress": {
      "dependencies": [
        "vitepress",
        "vuepress"
      ]
    },
    "Vite": {
      "dependencies": [
        "vite"
      ],
      "files": [
        "vite.config.*"
      ]
    },
    "Express / Node server": {
      "dependencies": [
        "express",
        "koa",
        "fastify",
        "hono",
        "@nestjs/core"
      ]
    },
    "Django": {
      "dependencies": [
        "django"
      ],
      "files": [
        "manage.py"
      ]
    },
    "Flask / FastAPI": {
      "dependencies": [
        "flask",
        "fastapi",
        "starlette"
      ]
    },
    "Rails": {
      "dependencies": [
        "rails"
      ],
      "files": [
        "config/routes.rb"
      ]
    },
    "Laravel": {
      "dependencies": [
        "laravel/framework"
      ],
      "files": [
        "artisan"
      ]
    },
    "WordPress": {
      "files": [
        "wp-config.php",
        "functions.php"
      ]
    },
    "Static HTML": {
      "files": [
        "index.html"
      ]
    },
    "Shopify theme": {
      "files": [
        "layout/theme.liquid",
        "config/settings_schema.json"
      ]
    },
    "Shopify Hydrogen": {
      "dependencies": [
        "@shopify/hydrogen"
      ]
    },
    "WordPress block theme": {
      "files": [
        "theme.json",
        "templates/index.html"
      ]
    },
    "Ghost theme": {
      "files": [
        "default.hbs",
        "post.hbs"
      ]
    },
    "Symfony / Twig": {
      "dependencies": [
        "symfony/framework-bundle",
        "twig/twig"
      ]
    },
    "Drupal": {
      "dependencies": [
        "drupal/core",
        "drupal/core-recommended"
      ]
    },
    "ASP.NET Razor": {
      "files": [
        "*.csproj",
        "_ViewImports.cshtml"
      ]
    }
  },
  "signals": [
    {
      "id": "build-config",
      "label": "Build/bundler configuration file",
      "regex": "(?:^|/)(?:vite|webpack|rollup|next|nuxt|astro|svelte|gatsby-config|angular|tsconfig|babel|postcss|tailwind|hugo|eleventy|\\.eleventy|docusaurus\\.config|remix\\.config|quasar\\.config)[\\w.-]*\\.(?:js|cjs|mjs|ts|json|toml|ya?ml)$|(?:^|/)_config\\.ya?ml$|(?:^|/)config/settings_schema\\.json$|(?:^|/)theme\\.json$|(?:^|/)shopify\\.theme\\.toml$",
      "files_only": true,
      "precision": "high",
      "examples": {
        "match": [
          "vite.config.ts",
          "next.config.mjs",
          "hugo.toml",
          "_config.yml",
          "config/settings_schema.json"
        ],
        "no_match": [
          "src/config.ts"
        ]
      }
    }
  ],
  "gaps": [],
  "framework_agnostic": true,
  "execution_hint": "Use manifests to know which libraries are available before adding new ones; edit the hosting config listed in deployment_config for server-level behaviour (redirects, headers, caching)."
}
