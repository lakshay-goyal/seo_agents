{
  "$schema": "./schema.json",
  "name": "shareability-link-assets",
  "signals": [
    {
      "id": "open-graph",
      "label": "Open Graph declaration",
      "regex": "og:(?:title|description|image|url|type|site_name)|openGraph\\s*:\\s*\\{",
      "block": false,
      "languages": [
        "@templates",
        "@content",
        "@data"
      ],
      "precision": "high",
      "examples": {
        "match": [
          "og:title",
          "openGraph: {"
        ],
        "no_match": [
          "graph: {"
        ]
      }
    },
    {
      "id": "twitter-card",
      "label": "Twitter/X card declaration",
      "regex": "twitter:(?:card|title|description|image|site|creator)|twitter\\s*:\\s*\\{[^}]*\\bcard\\b",
      "languages": [
        "@templates",
        "@content",
        "@data"
      ],
      "precision": "high",
      "examples": {
        "match": [
          "twitter:card",
          "twitter: { card",
          "twitter: { title: 'x', card: 'summary_large_image' }"
        ],
        "no_match": [
          "twitter.com"
        ]
      }
    },
    {
      "id": "og-image-generator",
      "label": "Generated OG image",
      "regex": "ImageResponse\\s*\\(|@vercel/og|\\bsatori\\b",
      "files_only": false,
      "languages": [
        "@templates"
      ],
      "precision": "medium",
      "examples": {
        "match": [
          "new ImageResponse(",
          "import { ImageResponse } from '@vercel/og'"
        ],
        "no_match": [
          "new Response("
        ]
      }
    },
    {
      "id": "share-intent",
      "label": "Share button / intent URL",
      "regex": "twitter\\.com/intent|x\\.com/intent|facebook\\.com/sharer|linkedin\\.com/(?:sharing|shareArticle)|reddit\\.com/submit|api\\.whatsapp\\.com/send|wa\\.me/\\?text|navigator\\.share\\s*\\(|react-share|vue-social-sharing",
      "ignore_case": true,
      "languages": [
        "@templates"
      ],
      "precision": "high",
      "examples": {
        "match": [
          "https://twitter.com/intent/tweet?text=x",
          "navigator.share({"
        ],
        "no_match": [
          "https://twitter.com/acme"
        ]
      }
    },
    {
      "id": "feed",
      "label": "RSS/Atom feed",
      "regex": "application/(?:rss|atom)\\+xml|@astrojs/rss|from\\s+['\"](?:rss|feed)['\"]|(?:^|/)(?:rss|feed|atom)\\.xml",
      "ignore_case": true,
      "languages": [
        "@templates",
        "@content",
        "@data"
      ],
      "precision": "high",
      "examples": {
        "match": [
          "type=\"application/rss+xml\"",
          "import rss from '@astrojs/rss'"
        ],
        "no_match": [
          "feedback"
        ]
      }
    },
    {
      "id": "linkable-section",
      "label": "Linkable content section (blog/resources/guides/case studies/tools)",
      "regex": "(?:^|/)(?:blog|posts?|articles?|resources|guides?|case-studies|research|tools?|glossary|docs)/",
      "files_only": true,
      "precision": "medium",
      "examples": {
        "match": [
          "src/pages/blog/index.astro",
          "content/guides/a.md"
        ],
        "no_match": [
          "src/components/Button.tsx"
        ]
      }
    },
    {
      "id": "downloadable",
      "label": "Downloadable resource link",
      "regex": "href\\s*=\\s*['\\\"{][^'\\\"}]*\\.(?:pdf|csv|xlsx|zip)['\\\"}]|<a\\b[^>]*\\sdownload(?:\\s*=|[\\s>])",
      "ignore_case": true,
      "languages": [
        "@templates",
        "@content"
      ],
      "precision": "high",
      "examples": {
        "match": [
          "<a href=\"/guide.pdf\">",
          "<a href=\"/x\" download>"
        ],
        "no_match": [
          "downloadFile(url)",
          "npm run download"
        ]
      }
    },
    {
      "id": "embed",
      "label": "Embed code / widget offered",
      "regex": "<iframe[^>]+src=|embed\\s*code|oembed",
      "ignore_case": true,
      "languages": [
        "@templates"
      ],
      "precision": "medium",
      "examples": {
        "match": [
          "<iframe src=\"https://youtube.com/embed/x\">",
          "oembed"
        ],
        "no_match": [
          "embedded"
        ]
      }
    },
    {
      "id": "newsletter",
      "label": "Newsletter / subscribe capture",
      "regex": "\\bnewsletter\\b|\\bsubscribe\\s+(?:to|now|for)\\b|>\\s*subscribe\\s*<|mailchimp|list-manage\\.com|convertkit|buttondown|substack\\.com|beehiiv|klaviyo|\\{%-?\\s*form\\s+['\\\"]customer['\\\"]",
      "ignore_case": true,
      "languages": [
        "@templates",
        "@content"
      ],
      "precision": "medium",
      "examples": {
        "match": [
          "Subscribe to our newsletter",
          "<button>Subscribe</button>",
          "{% form 'customer' %}"
        ],
        "no_match": [
          "observable.subscribe(x => x)",
          "store.subscribe(() => {})"
        ]
      }
    },
    {
      "id": "og-image-file",
      "label": "Open Graph / Twitter image file convention (Next opengraph-image, twitter-image)",
      "regex": "(?:^|/)(?:opengraph|twitter)-image(?:-\\w+)?\\.(?:tsx|jsx|ts|js|png|jpe?g|gif|webp)$|(?:^|/)og(?:-image)?\\.(?:png|jpe?g|webp)$",
      "files_only": true,
      "precision": "high",
      "examples": {
        "match": [
          "app/opengraph-image.png",
          "app/blog/[slug]/opengraph-image.tsx",
          "public/og.png"
        ],
        "no_match": [
          "public/logo.png"
        ]
      }
    }
  ],
  "gaps": [
    {
      "id": "no-og",
      "label": "No Open Graph tags found",
      "when_none_of": [
        "open-graph"
      ]
    },
    {
      "id": "no-twitter-card",
      "label": "No Twitter/X card found",
      "when_none_of": [
        "twitter-card"
      ]
    },
    {
      "id": "no-feed",
      "label": "Content sections exist but no RSS/Atom feed found",
      "when_none_of": [
        "feed"
      ],
      "only_if_any": [
        "linkable-section"
      ]
    }
  ],
  "framework_agnostic": true,
  "execution_hint": "Add og:title/description/image/url and twitter:card in the shared metadata layer with per-page overrides; generate per-page OG images; expose an RSS feed for content sections; add share links to article templates."
}
