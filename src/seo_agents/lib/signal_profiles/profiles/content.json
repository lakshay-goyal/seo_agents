{
  "$schema": "./schema.json",
  "name": "content",
  "signals": [
    {
      "id": "content-collection",
      "label": "Content collection / CMS schema",
      "regex": "defineCollection\\s*\\(|defineDocumentType\\s*\\(|createClient\\s*\\(\\s*\\{[^}]*(?:space|projectId|apiKey)",
      "block": true,
      "languages": [
        "@templates"
      ],
      "precision": "high",
      "examples": {
        "match": [
          "defineCollection({"
        ],
        "no_match": [
          "collection.find("
        ]
      }
    },
    {
      "id": "cms-fetch",
      "label": "CMS / headless content fetch",
      "regex": "(?:contentful|sanity|strapi|prismic|storyblok|graphcms|hygraph|datocms|wordpress|ghost|directus|payload)[\\w.]*\\.(?:get|fetch|query)\\w*\\s*\\(|/wp-json/|groq`",
      "ignore_case": true,
      "block": true,
      "languages": [
        "@templates",
        "@server"
      ],
      "precision": "medium",
      "examples": {
        "match": [
          "sanityClient.fetch(query)",
          "fetch('https://x.com/wp-json/wp/v2/posts')"
        ],
        "no_match": [
          "fetch('/api/posts')"
        ]
      }
    },
    {
      "id": "platform-content",
      "label": "Platform/CMS-managed copy rendered by template objects (WordPress loop, Shopify/Ghost objects, Hugo page vars)",
      "regex": "\\bWP_Query\\b|\\bhave_posts\\s*\\(|\\bthe_(?:content|title|excerpt)\\s*\\(|\\{\\{-?\\s*(?:product|collection|article|page|blog|section\\.settings|block\\.settings|shop)\\.\\w+|\\{\\{#(?:foreach|post|get)\\b|\\{\\{-?\\s*\\.(?:Content|Title|Summary|Params\\.\\w+)",
      "languages": [
        "@markup"
      ],
      "precision": "medium",
      "examples": {
        "match": [
          "<?php the_content(); ?>",
          "{{ product.title }}",
          "{{ .Content }}",
          "{{#foreach posts}}"
        ],
        "no_match": [
          "{{ title }}"
        ]
      }
    }
  ],
  "gaps": [
    {
      "id": "no-h1",
      "label": "No literal <h1> or Markdown '# ' heading found in any template",
      "when_none_of": [
        "@heading:1"
      ]
    }
  ],
  "framework_agnostic": true,
  "execution_hint": "Edit copy where the text record points (template markup, Markdown body or data file value). Content coming from CMS fetches must be changed in the CMS, not in code."
}
