{
  "$schema": "./schema.json",
  "name": "sitemap-robots",
  "signals": [
    {
      "id": "sitemap-file",
      "label": "Static sitemap file",
      "regex": "(?:^|/)sitemap[\\w-]*\\.xml(?:\\.gz)?$",
      "files_only": true,
      "precision": "high",
      "examples": {
        "match": [
          "public/sitemap.xml",
          "sitemap-index.xml",
          "public/sitemap-0.xml.gz"
        ],
        "no_match": [
          "sitemaps.md"
        ]
      }
    },
    {
      "id": "robots-file",
      "label": "Static robots.txt",
      "regex": "(?:^|/)robots\\.txt$",
      "files_only": true,
      "precision": "high",
      "examples": {
        "match": [
          "public/robots.txt"
        ],
        "no_match": [
          "robots.md"
        ]
      }
    },
    {
      "id": "sitemap-generator",
      "label": "Sitemap generator code/plugin",
      "regex": "next-sitemap|@astrojs/sitemap|gatsby-plugin-sitemap|@nuxtjs/sitemap|nuxt-simple-sitemap|@nuxtjs/seo|vite-plugin-sitemap|sitemap_generator|jekyll-sitemap|@11ty/eleventy-plugin-sitemap|laravel-sitemap|django\\.contrib\\.sitemaps|MetadataRoute\\.Sitemap|SitemapStream|\\bwp_sitemaps\\w*|WP_Sitemaps|svelte-sitemap|super-sitemap|enableSitemap|[\\'\"`/]sitemap(?:\\.xml)?[\\'\"`]",
      "block": true,
      "languages": [
        "@templates",
        "@data",
        "@server"
      ],
      "exclude_comments": true,
      "precision": "medium",
      "examples": {
        "match": [
          "import sitemap from '@astrojs/sitemap'",
          "MetadataRoute.Sitemap",
          "'/sitemap.xml'"
        ],
        "no_match": [
          "site map"
        ]
      }
    },
    {
      "id": "sitemap-route-file",
      "label": "Sitemap route/endpoint file",
      "regex": "(?:^|/)sitemap(?:\\.xml)?(?:/\\+server|/route)?\\.(?:ts|js|tsx|jsx|py|rb|php)$|(?:^|/)sitemap\\[\\.\\]xml",
      "files_only": true,
      "precision": "high",
      "examples": {
        "match": [
          "app/sitemap.ts",
          "src/routes/sitemap.xml/+server.ts"
        ],
        "no_match": [
          "src/sitemapUtils.ts"
        ]
      }
    },
    {
      "id": "robots-generator",
      "label": "Robots generator code/plugin",
      "regex": "MetadataRoute\\.Robots|gatsby-plugin-robots-txt|@nuxtjs/robots|nuxt-simple-robots|astro-robots-txt|enableRobotsTXT|[\\'\"`/]robots\\.txt[\\'\"`]",
      "block": true,
      "languages": [
        "@templates",
        "@data",
        "@server"
      ],
      "exclude_comments": true,
      "precision": "medium",
      "examples": {
        "match": [
          "MetadataRoute.Robots",
          "'/robots.txt'"
        ],
        "no_match": [
          "robots"
        ]
      }
    },
    {
      "id": "robots-route-file",
      "label": "Robots route/endpoint file",
      "regex": "(?:^|/)robots(?:\\.txt)?(?:/\\+server|/route)?\\.(?:ts|js|py|rb|php)$",
      "files_only": true,
      "precision": "high",
      "examples": {
        "match": [
          "app/robots.ts"
        ],
        "no_match": [
          "robots.md"
        ]
      }
    },
    {
      "id": "noindex",
      "label": "noindex directive (meta robots, X-Robots-Tag, metadata API or platform setting)",
      "regex": "\\bnoindex\\b|\\bnone\\b(?=[^\\n]{0,40}robots)|\\bwp_robots_no_robots\\b|\\bblog_public\\b|\\bindex\\s*:\\s*false\\b(?=[^\\n]{0,80}\\bfollow\\b)|robots\\s*:\\s*\\{[^}\\n]*\\bindex\\s*:\\s*false",
      "precision": "high",
      "ignore_case": true,
      "languages": [
        "@markup",
        "@scripts",
        "@server",
        "server-config",
        "text",
        "@data"
      ],
      "exclude_comments": true,
      "examples": {
        "match": [
          "<meta name=\"robots\" content=\"noindex\">",
          "robots: { index: false }",
          "Header set X-Robots-Tag noindex"
        ],
        "no_match": [
          "robots: { index: true }",
          "indexOf(x)",
          "<a rel=\"nofollow\" href=\"/x\">",
          "express.static(dir, { index: false })"
        ]
      }
    },
    {
      "id": "feed",
      "label": "RSS/Atom feed",
      "regex": "(?:^|/)(?:rss|feed|atom)(?:\\.xml)?(?:/\\+server|/route)?\\.(?:xml|ts|js)$",
      "files_only": true,
      "precision": "high",
      "examples": {
        "match": [
          "public/rss.xml",
          "src/pages/feed.xml.ts",
          "src/routes/rss.xml/+server.ts"
        ],
        "no_match": [
          "feedback.ts"
        ]
      }
    },
    {
      "id": "meta-robots",
      "label": "<meta name=\"robots\"> value",
      "value_group": 1,
      "precision": "high",
      "ignore_case": true,
      "regex": "<meta\\b(?=[^>]*\\bname\\s*=\\s*[\"'](?:robots|googlebot|bingbot)[\"'])[^>]*?\\bcontent\\s*=\\s*[\"'{]\\s*[\"'`]?([^\"'`}]*)",
      "languages": [
        "@markup",
        "@scripts"
      ],
      "exclude_comments": true,
      "examples": {
        "match": [
          "<meta name=\"robots\" content=\"noindex, nofollow\">",
          "<meta content=\"x\" name=\"robots\" content=\"index\">"
        ],
        "no_match": [
          "<meta name=\"description\" content=\"noindex\">"
        ]
      }
    },
    {
      "id": "x-robots-tag",
      "label": "X-Robots-Tag header value",
      "value_group": 1,
      "precision": "high",
      "ignore_case": true,
      "regex": "X-Robots-Tag[\"']?\\s*[:,]?\\s*(?:[\"']?\\s*(?:value[\"']?\\s*:\\s*)?[\"']?)([\\w ,:-]+)",
      "languages": [
        "@scripts",
        "@data",
        "server-config",
        "other",
        "python",
        "ruby",
        "php"
      ],
      "exclude_comments": true,
      "examples": {
        "match": [
          "Header set X-Robots-Tag \"noindex\"",
          "{ key: 'X-Robots-Tag', value: 'noindex' }",
          "X-Robots-Tag: noindex"
        ],
        "no_match": [
          "X-Frame-Options: DENY"
        ]
      }
    },
    {
      "id": "metadata-robots",
      "label": "Framework metadata robots setting",
      "value_group": 1,
      "precision": "high",
      "regex": "\\brobots\\s*:\\s*(\\{[^{}\\n]*\\}|[\"'`][^\"'`\\n]+[\"'`])",
      "languages": [
        "@scripts",
        "@markup",
        "@data"
      ],
      "exclude_comments": true,
      "examples": {
        "match": [
          "robots: { index: false, follow: true }",
          "robots: 'noindex'"
        ],
        "no_match": [
          "robots.txt"
        ]
      }
    },
    {
      "id": "sitemap-template",
      "label": "Sitemap/robots generated from a template (Hugo, Jekyll, 11ty, WordPress, Liquid)",
      "regex": "(?:^|/)(?:layouts/(?:_default/)?(?:sitemap|robots)\\.(?:xml|txt)|_includes/sitemap\\.xml|sitemap\\.(?:njk|liquid|11ty\\.js|xml\\.erb|xml\\.php|hbs)|robots\\.(?:njk|liquid|txt\\.erb|hbs))$",
      "files_only": true,
      "precision": "high",
      "examples": {
        "match": [
          "layouts/sitemap.xml",
          "layouts/_default/robots.txt",
          "sitemap.njk"
        ],
        "no_match": [
          "public/sitemap.xml"
        ]
      }
    }
  ],
  "gaps": [
    {
      "id": "no-sitemap",
      "label": "No sitemap file or generator found",
      "when_none_of": [
        "sitemap-file",
        "sitemap-generator",
        "sitemap-route-file",
        "sitemap-template"
      ]
    },
    {
      "id": "no-robots",
      "label": "No robots.txt or generator found",
      "when_none_of": [
        "robots-file",
        "robots-generator",
        "robots-route-file",
        "sitemap-template"
      ]
    }
  ],
  "framework_agnostic": true,
  "execution_hint": "Prefer generating the sitemap from the same route/content source the app uses so new pages are included automatically; reference the sitemap URL from robots.txt; remove noindex from pages that should rank."
}
