{
  "$schema": "./schema.json",
  "name": "routes",
  "framework_agnostic": true,
  "conventions": [
    {
      "pattern": "^(?:.*/)?layout/(?P<name>[\\w-]+)\\.liquid$",
      "kind": "layout",
      "adapter": "shopify-theme",
      "requires_path": "(?:^|/)layout/theme\\.liquid$",
      "route_map": {
        "theme": "/",
        "password": "/password"
      },
      "route_default": "/"
    },
    {
      "pattern": "^(?:.*/)?templates/customers/(?P<name>[\\w-]+)(?:\\.[\\w-]+)?\\.(?:json|liquid)$",
      "kind": "page",
      "adapter": "shopify-theme",
      "requires_path": "(?:^|/)layout/theme\\.liquid$",
      "route_map": {
        "index": "/",
        "product": "/products/:handle",
        "collection": "/collections/:handle",
        "list-collections": "/collections",
        "page": "/pages/:handle",
        "blog": "/blogs/:blog",
        "article": "/blogs/:blog/:article",
        "cart": "/cart",
        "search": "/search",
        "404": "/404",
        "password": "/password",
        "gift_card": "/gift_cards/:id",
        "account": "/account",
        "login": "/account/login",
        "register": "/account/register",
        "order": "/account/orders/:id",
        "addresses": "/account/addresses",
        "reset_password": "/account/reset/:token",
        "activate_account": "/account/activate/:token"
      }
    },
    {
      "pattern": "^(?:.*/)?templates/(?P<name>404)(?:\\.[\\w-]+)?\\.(?:json|liquid)$",
      "kind": "not-found",
      "adapter": "shopify-theme",
      "requires_path": "(?:^|/)layout/theme\\.liquid$",
      "route_map": {
        "index": "/",
        "product": "/products/:handle",
        "collection": "/collections/:handle",
        "list-collections": "/collections",
        "page": "/pages/:handle",
        "blog": "/blogs/:blog",
        "article": "/blogs/:blog/:article",
        "cart": "/cart",
        "search": "/search",
        "404": "/404",
        "password": "/password",
        "gift_card": "/gift_cards/:id",
        "account": "/account",
        "login": "/account/login",
        "register": "/account/register",
        "order": "/account/orders/:id",
        "addresses": "/account/addresses",
        "reset_password": "/account/reset/:token",
        "activate_account": "/account/activate/:token"
      }
    },
    {
      "pattern": "^(?:.*/)?templates/(?P<name>[\\w-]+)(?P<variant>\\.[\\w-]+)?\\.(?:json|liquid)$",
      "kind": "page",
      "adapter": "shopify-theme",
      "requires_path": "(?:^|/)layout/theme\\.liquid$",
      "route_map": {
        "index": "/",
        "product": "/products/:handle",
        "collection": "/collections/:handle",
        "list-collections": "/collections",
        "page": "/pages/:handle",
        "blog": "/blogs/:blog",
        "article": "/blogs/:blog/:article",
        "cart": "/cart",
        "search": "/search",
        "404": "/404",
        "password": "/password",
        "gift_card": "/gift_cards/:id",
        "account": "/account",
        "login": "/account/login",
        "register": "/account/register",
        "order": "/account/orders/:id",
        "addresses": "/account/addresses",
        "reset_password": "/account/reset/:token",
        "activate_account": "/account/activate/:token"
      }
    },
    {
      "pattern": "^(?:wp-content/themes/[\\w.-]+/|[\\w.-]+/)?templates/(?P<name>404)\\.html$",
      "kind": "not-found",
      "adapter": "wordpress-block-theme",
      "requires_path": "(?:^|/)theme\\.json$",
      "route_map": {
        "front-page": "/",
        "home": "/",
        "index": "/",
        "single": "/:post",
        "singular": "/:post",
        "page": "/:page",
        "archive": "/:post_type",
        "category": "/category/:slug",
        "tag": "/tag/:slug",
        "author": "/author/:slug",
        "search": "/search/:query",
        "date": "/:year/:month",
        "attachment": "/:attachment",
        "taxonomy": "/:taxonomy/:term",
        "privacy-policy": "/privacy-policy",
        "404": "/404"
      }
    },
    {
      "pattern": "^(?:wp-content/themes/[\\w.-]+/|[\\w.-]+/)?templates/(?P<name>front-page|home|index|single|singular|page|archive|category|tag|author|search|date|attachment|taxonomy|privacy-policy)\\.html$",
      "kind": "page",
      "adapter": "wordpress-block-theme",
      "requires_path": "(?:^|/)theme\\.json$",
      "route_map": {
        "front-page": "/",
        "home": "/",
        "index": "/",
        "single": "/:post",
        "singular": "/:post",
        "page": "/:page",
        "archive": "/:post_type",
        "category": "/category/:slug",
        "tag": "/tag/:slug",
        "author": "/author/:slug",
        "search": "/search/:query",
        "date": "/:year/:month",
        "attachment": "/:attachment",
        "taxonomy": "/:taxonomy/:term",
        "privacy-policy": "/privacy-policy",
        "404": "/404"
      }
    },
    {
      "pattern": "^(?:wp-content/themes/[\\w.-]+/|[\\w.-]+/)?templates/page-(?P<slug>[\\w-]+)\\.html$",
      "kind": "page",
      "adapter": "wordpress-block-theme",
      "requires_path": "(?:^|/)theme\\.json$",
      "route_template": "/{slug}"
    },
    {
      "pattern": "^(?:wp-content/themes/[\\w.-]+/|[\\w.-]+/)?templates/single-(?P<slug>[\\w-]+)\\.html$",
      "kind": "page",
      "adapter": "wordpress-block-theme",
      "requires_path": "(?:^|/)theme\\.json$",
      "route_template": "/{slug}/:post"
    },
    {
      "pattern": "^(?:wp-content/themes/[\\w.-]+/|[\\w.-]+/)?templates/archive-(?P<slug>[\\w-]+)\\.html$",
      "kind": "page",
      "adapter": "wordpress-block-theme",
      "requires_path": "(?:^|/)theme\\.json$",
      "route_template": "/{slug}"
    },
    {
      "pattern": "^(?:wp-content/themes/[\\w.-]+/|[\\w.-]+/)?parts/(?P<name>[\\w-]+)\\.html$",
      "kind": "layout",
      "adapter": "wordpress-block-theme",
      "requires_path": "(?:^|/)theme\\.json$",
      "route_default": "/"
    },
    {
      "pattern": "^(?:wp-content/themes/[\\w.-]+/|[\\w.-]+/)?(?P<name>404)\\.php$",
      "kind": "not-found",
      "adapter": "wordpress-template-hierarchy",
      "requires_path": "(?:^|/)(?:functions\\.php|wp-config(?:-sample)?\\.php)$",
      "route_map": {
        "front-page": "/",
        "home": "/",
        "index": "/",
        "single": "/:post",
        "singular": "/:post",
        "page": "/:page",
        "archive": "/:post_type",
        "category": "/category/:slug",
        "tag": "/tag/:slug",
        "author": "/author/:slug",
        "search": "/search/:query",
        "date": "/:year/:month",
        "attachment": "/:attachment",
        "taxonomy": "/:taxonomy/:term",
        "privacy-policy": "/privacy-policy",
        "404": "/404"
      }
    },
    {
      "pattern": "^(?:wp-content/themes/[\\w.-]+/|[\\w.-]+/)?(?P<name>front-page|home|index|single|singular|page|archive|category|tag|author|search|date|attachment|taxonomy|privacy-policy)\\.php$",
      "kind": "page",
      "adapter": "wordpress-template-hierarchy",
      "requires_path": "(?:^|/)(?:functions\\.php|wp-config(?:-sample)?\\.php)$",
      "route_map": {
        "front-page": "/",
        "home": "/",
        "index": "/",
        "single": "/:post",
        "singular": "/:post",
        "page": "/:page",
        "archive": "/:post_type",
        "category": "/category/:slug",
        "tag": "/tag/:slug",
        "author": "/author/:slug",
        "search": "/search/:query",
        "date": "/:year/:month",
        "attachment": "/:attachment",
        "taxonomy": "/:taxonomy/:term",
        "privacy-policy": "/privacy-policy",
        "404": "/404"
      }
    },
    {
      "pattern": "^(?:wp-content/themes/[\\w.-]+/|[\\w.-]+/)?page-(?P<slug>[\\w-]+)\\.php$",
      "kind": "page",
      "adapter": "wordpress-template-hierarchy",
      "requires_path": "(?:^|/)(?:functions\\.php|wp-config(?:-sample)?\\.php)$",
      "route_template": "/{slug}"
    },
    {
      "pattern": "^(?:wp-content/themes/[\\w.-]+/|[\\w.-]+/)?single-(?P<slug>[\\w-]+)\\.php$",
      "kind": "page",
      "adapter": "wordpress-template-hierarchy",
      "requires_path": "(?:^|/)(?:functions\\.php|wp-config(?:-sample)?\\.php)$",
      "route_template": "/{slug}/:post"
    },
    {
      "pattern": "^(?:wp-content/themes/[\\w.-]+/|[\\w.-]+/)?archive-(?P<slug>[\\w-]+)\\.php$",
      "kind": "page",
      "adapter": "wordpress-template-hierarchy",
      "requires_path": "(?:^|/)(?:functions\\.php|wp-config(?:-sample)?\\.php)$",
      "route_template": "/{slug}"
    },
    {
      "pattern": "^(?:wp-content/themes/[\\w.-]+/|[\\w.-]+/)?category-(?P<slug>[\\w-]+)\\.php$",
      "kind": "page",
      "adapter": "wordpress-template-hierarchy",
      "requires_path": "(?:^|/)(?:functions\\.php|wp-config(?:-sample)?\\.php)$",
      "route_template": "/category/{slug}"
    },
    {
      "pattern": "^(?:wp-content/themes/[\\w.-]+/|[\\w.-]+/)?tag-(?P<slug>[\\w-]+)\\.php$",
      "kind": "page",
      "adapter": "wordpress-template-hierarchy",
      "requires_path": "(?:^|/)(?:functions\\.php|wp-config(?:-sample)?\\.php)$",
      "route_template": "/tag/{slug}"
    },
    {
      "pattern": "^(?:wp-content/themes/[\\w.-]+/|[\\w.-]+/)?taxonomy-(?P<slug>[\\w-]+)\\.php$",
      "kind": "page",
      "adapter": "wordpress-template-hierarchy",
      "requires_path": "(?:^|/)(?:functions\\.php|wp-config(?:-sample)?\\.php)$",
      "route_template": "/{slug}/:term"
    },
    {
      "pattern": "^(?:wp-content/themes/[\\w.-]+/|[\\w.-]+/)?author-(?P<slug>[\\w-]+)\\.php$",
      "kind": "page",
      "adapter": "wordpress-template-hierarchy",
      "requires_path": "(?:^|/)(?:functions\\.php|wp-config(?:-sample)?\\.php)$",
      "route_template": "/author/{slug}"
    },
    {
      "pattern": "^(?:wp-content/themes/[\\w.-]+/|[\\w.-]+/)?(?P<name>header|footer|sidebar)(?:-[\\w-]+)?\\.php$",
      "kind": "layout",
      "adapter": "wordpress-template-hierarchy",
      "requires_path": "(?:^|/)(?:functions\\.php|wp-config(?:-sample)?\\.php)$",
      "route_default": "/"
    },
    {
      "pattern": "^(?P<name>error-404|error)\\.hbs$",
      "kind": "not-found",
      "adapter": "ghost-theme",
      "requires_path": "(?:^|/)default\\.hbs$",
      "route_default": "/404"
    },
    {
      "pattern": "^(?P<name>index|home|post|page|tag|author)\\.hbs$",
      "kind": "page",
      "adapter": "ghost-theme",
      "requires_path": "(?:^|/)default\\.hbs$",
      "route_map": {
        "index": "/",
        "home": "/",
        "post": "/:slug",
        "page": "/:slug",
        "tag": "/tag/:slug",
        "author": "/author/:slug"
      }
    },
    {
      "pattern": "^custom-(?P<slug>[\\w-]+)\\.hbs$",
      "kind": "template",
      "adapter": "ghost-theme",
      "requires_path": "(?:^|/)default\\.hbs$",
      "route_template": "/:slug"
    },
    {
      "pattern": "^(?P<name>default)\\.hbs$",
      "kind": "layout",
      "adapter": "ghost-theme",
      "requires_path": "(?:^|/)default\\.hbs$",
      "route_default": "/"
    },
    {
      "pattern": "^(?:themes/[\\w-]+/)?layouts/(?P<name>index)\\.html$",
      "kind": "page",
      "adapter": "hugo",
      "requires_path": "^(?:hugo|config)\\.(?:toml|ya?ml|json)$|(?:^|/)layouts/_default/baseof\\.html$",
      "route_default": "/"
    },
    {
      "pattern": "^(?:themes/[\\w-]+/)?layouts/(?P<route>(?!_default|partials|_partials|shortcodes)[\\w-]+)/list\\.html$",
      "kind": "template",
      "adapter": "hugo",
      "requires_path": "^(?:hugo|config)\\.(?:toml|ya?ml|json)$|(?:^|/)layouts/_default/baseof\\.html$",
      "route_template": "/{route}"
    },
    {
      "pattern": "^(?:themes/[\\w-]+/)?layouts/(?P<route>(?!_default|partials|_partials|shortcodes)[\\w-]+)/single\\.html$",
      "kind": "template",
      "adapter": "hugo",
      "requires_path": "^(?:hugo|config)\\.(?:toml|ya?ml|json)$|(?:^|/)layouts/_default/baseof\\.html$",
      "route_template": "/{route}/:slug"
    },
    {
      "pattern": "^(?:themes/[\\w-]+/)?layouts/(?P<name>_default/[\\w.-]+)\\.html$",
      "kind": "layout",
      "adapter": "hugo",
      "requires_path": "^(?:hugo|config)\\.(?:toml|ya?ml|json)$|(?:^|/)layouts/_default/baseof\\.html$",
      "route_default": "/"
    },
    {
      "pattern": "^(?:src/)?app/(?P<route>(?:.*/)?)page\\.(?:tsx|jsx|ts|js|mdx|md)$",
      "kind": "page",
      "adapter": "next-app"
    },
    {
      "pattern": "^(?:src/)?app/(?P<route>(?:.*/)?)layout\\.(?:tsx|jsx|ts|js)$",
      "kind": "layout",
      "adapter": "next-app"
    },
    {
      "pattern": "^(?:src/)?app/(?P<route>(?:.*/)?)(?:not-found|error)\\.(?:tsx|jsx|ts|js)$",
      "kind": "not-found",
      "adapter": "next-app"
    },
    {
      "pattern": "^(?:src/)?app/(?P<route>(?:.*/)?)route\\.(?:ts|js)$",
      "kind": "endpoint",
      "adapter": "next-app"
    },
    {
      "pattern": "^(?:src/)?pages/api/(?P<route>.+)\\.(?:tsx|jsx|ts|js)$",
      "kind": "endpoint",
      "adapter": "next-pages"
    },
    {
      "pattern": "^(?:src/|app/)?pages/(?P<route>.+)\\.(?:tsx|jsx|ts|js|mdx|md|vue|astro|svelte|html)$",
      "kind": "page",
      "adapter": "file-pages",
      "exclude": "(?:^|/)_(?:app|document|error)$|^(?:404|500)$|^api/|(?:^|/)_[^/]*$"
    },
    {
      "pattern": "^(?:src/|app/)?pages/(?P<route>404|500)\\.\\w+$",
      "kind": "not-found",
      "adapter": "file-pages"
    },
    {
      "pattern": "^src/routes/(?P<route>(?:.*/)?)\\+page\\.svelte$",
      "kind": "page",
      "adapter": "sveltekit"
    },
    {
      "pattern": "^src/routes/(?P<route>(?:.*/)?)\\+layout\\.svelte$",
      "kind": "layout",
      "adapter": "sveltekit"
    },
    {
      "pattern": "^src/routes/(?P<route>(?:.*/)?)\\+error\\.svelte$",
      "kind": "not-found",
      "adapter": "sveltekit"
    },
    {
      "pattern": "^src/routes/(?P<route>(?:.*/)?)\\+server\\.(?:ts|js)$",
      "kind": "endpoint",
      "adapter": "sveltekit"
    },
    {
      "pattern": "^app/routes/(?P<route>[^/]+?)(?:/route)?\\.(?:tsx|jsx|ts|js|mdx)$",
      "kind": "page",
      "dot_segments": true,
      "adapter": "remix-flat-routes",
      "exclude": "^_?_?root$"
    },
    {
      "pattern": "^app/root\\.(?:tsx|jsx)$",
      "kind": "layout",
      "adapter": "remix-flat-routes",
      "route_default": "/"
    },
    {
      "pattern": "^(?:src/)?routes/(?P<route>[^+]+)\\.(?:tsx|jsx)$",
      "kind": "page",
      "exclude": "(?:^|/)__root$|\\.lazy$",
      "adapter": "file-routes"
    },
    {
      "pattern": "^(?:src/|app/)?layouts?/(?P<route>.+)\\.(?:vue|astro|svelte|tsx|jsx|html|njk|liquid)$",
      "kind": "layout",
      "adapter": "layouts-directory",
      "exclude": "^(?:partials|_partials|shortcodes)/"
    },
    {
      "pattern": "^(?:src/)?_(?:includes|layouts)/(?P<route>.+)\\.(?:html|njk|liquid)$",
      "kind": "layout",
      "adapter": "jekyll-eleventy"
    },
    {
      "pattern": "^_posts/(?:\\d{4}-\\d{2}-\\d{2}-)?(?P<route>.+)\\.(?:md|markdown|html)$",
      "kind": "page",
      "adapter": "jekyll",
      "route_template": "/:year/:month/:day/{route}"
    },
    {
      "pattern": "^(?P<route>(?!README|CHANGELOG|LICENSE|CONTRIBUTING|CODE_OF_CONDUCT)[\\w-]+)\\.(?:md|markdown)$",
      "kind": "content-page",
      "adapter": "jekyll",
      "requires_path": "^_config\\.ya?ml$"
    },
    {
      "pattern": "^(?:src/)?content/(?P<route>.+?)(?:/_?index)?\\.(?:md|mdx|markdown)$",
      "kind": "content-page",
      "adapter": "content-directory"
    },
    {
      "pattern": "^(?:docs|blog|posts)/(?P<route>.+?)\\.(?:md|mdx)$",
      "kind": "content-page",
      "adapter": "content-directory"
    },
    {
      "pattern": "^(?:.*/)?templates/(?P<route>.+)\\.(?:html|jinja|j2|twig)$",
      "kind": "template",
      "adapter": "server-templates",
      "exclude": "(?:^|/)(?:_|partials/|includes/|components/|macros/|base\\b|layout)"
    },
    {
      "pattern": "^(?:.*/)?views/(?P<route>(?!layouts/|partials/|components/|shared/).+?)(?:\\.html)?\\.(?:erb|haml|slim|ejs|pug|hbs|handlebars|njk)$",
      "kind": "template",
      "adapter": "server-views",
      "exclude": "(?:^|/)_"
    },
    {
      "pattern": "^(?:.*/)?views/layouts/(?P<route>.+?)(?:\\.html)?\\.(?:erb|haml|slim|ejs|pug|hbs|handlebars)$",
      "kind": "layout",
      "adapter": "server-views"
    },
    {
      "pattern": "^resources/views/(?P<route>(?!layouts/|components/|partials/).+?)\\.blade\\.php$",
      "kind": "template",
      "adapter": "laravel-blade"
    },
    {
      "pattern": "^resources/views/layouts/(?P<route>.+?)\\.blade\\.php$",
      "kind": "layout",
      "adapter": "laravel-blade"
    },
    {
      "pattern": "^(?:src/app/|projects/[\\w-]+/src/app/)(?P<route>.+)\\.component\\.html$",
      "kind": "template",
      "adapter": "angular-component"
    },
    {
      "pattern": "^(?:public/|static/|src/|docs/|site/|www/|dist/)?(?P<route>(?![^/]*/node_modules/)[^.]+?)\\.html?$",
      "kind": "page",
      "adapter": "static-html",
      "exclude": "(?:^|/)(?:_|partials/|includes/|components/|layouts?/|templates/|views/|parts/|patterns/)|(?:^|/)(?:README|LICENSE)$|\\.component$"
    },
    {
      "pattern": "^(?:public/)?(?P<route>(?!vendor/|app/|config/|routes/|resources/|database/|tests?/|src/|lib/|includes?/|inc/|template-parts/|parts/|patterns/)[^./]+)\\.php$",
      "kind": "page",
      "adapter": "php-files",
      "exclude": "^(?:functions|wp-config|header|footer|sidebar|comments|searchform)$"
    }
  ],
  "declarations": [
    {
      "glob": "*.[jt]sx",
      "parser": "jsx-routes",
      "regex": "<Route\\b[^>]*?\\bpath\\s*=\\s*[{]?\\s*['\"`]([^'\"`]*)['\"`]",
      "kind": "page",
      "adapter": "react-router-jsx"
    },
    {
      "glob": "*.[jt]s*",
      "parser": "object-routes",
      "regex": "\\bpath\\s*:\\s*['\"`](/?[^'\"`]*)['\"`]",
      "kind": "page",
      "requires": "(?:createBrowserRouter|createHashRouter|createMemoryRouter|useRoutes|RouteObject|createRoute|createRouter|VueRouter|RouteRecordRaw|\\bRoutes\\s*=|:\\s*Routes\\b|RouterModule|provideRouter|new\\s+Router\\s*\\()",
      "adapter": "router-config"
    },
    {
      "glob": "*.vue",
      "parser": "object-routes",
      "regex": "\\bpath\\s*:\\s*['\"`](/?[^'\"`]*)['\"`]",
      "kind": "page",
      "requires": "createRouter",
      "adapter": "vue-router"
    },
    {
      "glob": "*.[jt]s",
      "regex": "\\b(?:app|router|server|fastify|api)\\.(?:get|all)\\s*\\(\\s*['\"`](/[^'\"`]*)['\"`]",
      "kind": "server-route",
      "adapter": "node-server"
    },
    {
      "glob": "*.ts",
      "regex": "@Get\\s*\\(\\s*['\"`]([^'\"`]*)['\"`]",
      "kind": "server-route",
      "adapter": "nestjs"
    },
    {
      "glob": "*.py",
      "regex": "@\\w+\\.(?:route|get|api_route)\\s*\\(\\s*['\"]([^'\"]*)['\"]",
      "kind": "server-route",
      "adapter": "flask-fastapi"
    },
    {
      "glob": "urls.py",
      "parser": "django-urls",
      "regex": "\\b(?:re_)?path\\s*\\(\\s*r?['\"]([^'\"]*)['\"]",
      "kind": "server-route",
      "adapter": "django-urls"
    },
    {
      "glob": "routes.rb",
      "parser": "rails-routes",
      "regex": "^\\s*(?:get|resources?|root)\\s*\\(?\\s*['\":]?([\\w/:\\-#]+)",
      "kind": "server-route",
      "adapter": "rails-routes"
    },
    {
      "glob": "web.php",
      "regex": "Route::(?:get|any|match|view)\\s*\\(\\s*['\"]([^'\"]*)['\"]",
      "kind": "server-route",
      "adapter": "laravel-routes"
    },
    {
      "glob": "web.php",
      "regex": "Route::resource\\s*\\(\\s*['\"]([^'\"]+)['\"]",
      "kind": "server-route",
      "adapter": "laravel-routes",
      "resource": true
    },
    {
      "glob": "gatsby-node.*",
      "regex": "createPage\\s*\\(\\s*\\{[^}]*?path\\s*:\\s*[`'\"]([^`'\"]+)",
      "kind": "page",
      "adapter": "gatsby-node"
    },
    {
      "glob": "*.md*",
      "regex": "^permalink:\\s*['\"]?([^'\"\\n]+)",
      "kind": "page",
      "adapter": "front-matter-permalink"
    },
    {
      "glob": "*.njk",
      "regex": "^permalink:\\s*['\"]?([^'\"\\n]+)",
      "kind": "page",
      "adapter": "front-matter-permalink"
    },
    {
      "glob": "*.html",
      "regex": "^permalink:\\s*['\"]?([^'\"\\n]+)",
