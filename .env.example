LANGSMITH_API_KEY=<LANGSMITH_API_KEY>
GITHUB_TOKEN=<GITHUB_TOKEN>
OPENROUTER_API_KEY=<OPENROUTER_API_KEY>
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Combined reasoning + output limit per model response.
OPENROUTER_MAX_TOKENS=32768
# Flash defaults to none. Use default to keep provider defaults, or a supported effort.
OPENROUTER_REASONING_EFFORT=none
# Repository tools are removed after this many model rounds; final output remains available.
SEO_MAX_DISCOVERY_ROUNDS=12
# Agent mode requires an OpenRouter model with tool calling.
SEO_EXPLORATION_MODE=agent
# For the legacy offline extractor, use SEO_EXPLORATION_MODE=static.
# SEO_NO_LLM=1 disables optional summaries and rejects agent mode.
SEO_NO_LLM=
# Tiered models for small gap workers / escalation (defaults to OPENROUTER_MODEL when unset).
OPENROUTER_SMALL_MODEL=
OPENROUTER_MID_MODEL=
# Deployed or preview origin to measure (rendered DOM, raw HTML, links, Lighthouse).
SEO_SITE_URL=
# 1 = provision Playwright/Chromium + Lighthouse in the sandbox and render pages.
SEO_RENDER=
# 1 = install, build and serve the repository inside the sandbox (time-boxed, best effort).
SEO_BUILD=
# 1 = also run the 7 legacy LLM category extractors (default off; the site model covers their data).
SEO_RUN_LLM_AGENTS=
# 1 = run Lighthouse per URL when available; PAGESPEED_API_KEY uses PageSpeed Insights instead for public URLs.
SEO_LIGHTHOUSE=
PAGESPEED_API_KEY=
# Path for a JSONL trace of model calls (tokens, cost, latency).
SEO_TRACE=
# --- Site model orchestrator (seo_reports/site_model) ---
# Max URLs measured (manifest + crawl) and parallel measurement workers.
SEO_MAX_PAGES=200
SEO_MEASURE_WORKERS=4
# Link status checks (internal: all; external: sample size).
SEO_CHECK_LINKS=1
SEO_EXTERNAL_LINK_SAMPLE=50
# Lighthouse runs per form factor (median by LCP) and representative pages per run.
SEO_LIGHTHOUSE_RUNS=3
SEO_LIGHTHOUSE_MAX_PAGES=12
# Cheap-model gap workers (default on when OPENROUTER_API_KEY is set): attribution ties,
# computed metadata, topic/intent, E-E-A-T classification, dynamic instances, unknown-framework adapters.
SEO_GAP_WORKERS=1
SEO_GAP_CONCURRENCY=6
SEO_GAP_MAX_TASKS=200
SEO_TOPIC_MAX_PAGES=40
SEO_EEAT_MAX_PAGES=20
# Gap answers are cached by packet hash (set 0 to disable); learned adapters are cached too.
SEO_GAP_CACHE=
SEO_ADAPTER_CACHE=
# Optional price table for cost logs: {"model": [usd_per_mtok_in, usd_per_mtok_out]}
SEO_MODEL_PRICES=
# --- Legacy LLM category extractors ---
SEO_REPAIR_ROUNDS=4
SEO_MAX_TOOL_CALLS=60
SEO_AGENT_CONCURRENCY=4
# --- Runtime, sandbox and PR (security + hygiene) ---
# Committed build output (dist/, out/): auto = serve only when no build runs (flagged as possibly stale),
# 1 = prefer it over building, 0 = never serve it.
SEO_MEASURE_PREBUILT=auto
# Max crawl click depth from /.
SEO_MAX_CRAWL_DEPTH=10
# 1 = stamp data-seo-src="file:line:col" on rendered elements of plain Vite apps (temporary wrapper config;
# client files are not edited). Best effort; other stacks fall back to string-match attribution.
SEO_INSTRUMENT=
# Parallel Lighthouse pages and long-lived Chromium render threads.
SEO_LIGHTHOUSE_CONCURRENCY=2
SEO_RENDER_BROWSERS=2
# Per-run sandbox limits; SEO_SANDBOX_REUSE=1 keeps one named container across runs (dev only).
SEO_SANDBOX_CPUS=4
SEO_SANDBOX_MEMORY=8g
SEO_SANDBOX_PIDS=4096
SEO_SANDBOX_REUSE=
# Unprivileged user that runs install/build/preview inside the sandbox (set by the host).
SEO_BUILD_USER=
# PR contents: only summary/manifest + on-page proposals within this byte budget are committed;
# SEO_PR_COMMIT_FULL=1 commits every JSON file. SEO_PR_BRANCH overrides the per-run branch name.
SEO_PR_COMMIT_BUDGET=50000
SEO_PR_COMMIT_FULL=
SEO_PR_BRANCH=
# Haiku-class tier between small and mid (used by gap workers / on-page when configured).
OPENROUTER_HAIKU_MODEL=
# --- Keyword research stage (seo_reports/keywords; python -m seo_agents.keyword_research) ---
# 1 = run keyword research in the sandbox right after the exploration (output lands on the same PR).
SEO_KEYWORD_RESEARCH=
# Target market (DataForSEO location_code / Google Ads geo target; 2840 = United States).
SEO_KEYWORD_COUNTRY=US
SEO_KEYWORD_LOCATION_CODE=2840
SEO_KEYWORD_LANGUAGE=en
# generate -> enrich -> judge iterations per page, pages researched in parallel, max pages.
SEO_KEYWORD_MAX_ITERATIONS=4
SEO_KEYWORD_CONCURRENCY=3
SEO_KEYWORD_MAX_PAGES=25
# Generator (LLM, needs OPENROUTER_API_KEY): model tier override, reasoning effort, token cap, validation attempts.
SEO_KEYWORD_TIER=
SEO_KEYWORD_REASONING_EFFORT=low
SEO_KEYWORD_MAX_TOKENS=12000
SEO_KEYWORD_ATTEMPTS=3
# Provider response cache (on by default; 0 disables), its folder and age limit.
SEO_KEYWORD_CACHE=
SEO_KEYWORD_CACHE_DIR=
SEO_KEYWORD_CACHE_TTL_DAYS=
# Autocomplete question expansion (0 disables) and max suggestions per seed.
SEO_KEYWORD_AUTOCOMPLETE=
SEO_KEYWORD_AUTOCOMPLETE_MAX=
# One SERP fetch per enriched keyword (0 disables; SERP intent / features / authority become unknown).
SEO_KEYWORD_ENRICH_SERP=
# Hard stop on provider spend per run (USD).
SEO_KEYWORD_MAX_SPEND=
# Optional tuning: competitor URLs per page, reverse keywords per URL, competitor keywords enriched up front,
# same-intent probability for the cannibalization guard.
SEO_KEYWORD_COMPETITOR_URLS=3
SEO_KEYWORD_COMPETITOR_KEYWORDS=100
SEO_KEYWORD_COMPETITOR_ENRICH=30
SEO_KEYWORD_SAME_INTENT=0.7
# DataForSEO (volume, difficulty, SERP, related/competitor keywords). Without it metrics are unknown.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# Google Ads Keyword Planner (Ads volume, bids, ideas).
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_API_VERSION=v26
# Google Search Console (queries the site already gets impressions for).
GSC_CLIENT_ID=
GSC_CLIENT_SECRET=
GSC_REFRESH_TOKEN=
GSC_SITE_URL=
# TypeSafe Jev judge. Without the key the judge runs heuristic-only and gate-passing keywords go to REVIEW.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
# Site authority used by the judge's difficulty expectations: low | medium | high.
KEYWORD_SITE_AUTHORITY=low
