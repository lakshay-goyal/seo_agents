LANGSMITH_API_KEY=<LANGSMITH_API_KEY>
GITHUB_TOKEN=<GITHUB_TOKEN>
OPENROUTER_API_KEY=<OPENROUTER_API_KEY>
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Combined reasoning + output limit per model response.
OPENROUTER_MAX_TOKENS=32768
# Flash defaults to none. Use default to keep provider defaults, or a supported effort.
OPENROUTER_REASONING_EFFORT=none
# Repository tools are removed after this many model rounds; final output remains available.
SEO_MAX_DISCOVERY_ROUNDS=12
# Agent mode requires an OpenRouter model with tool calling.
SEO_EXPLORATION_MODE=agent
# For the legacy offline extractor, use SEO_EXPLORATION_MODE=static.
# SEO_NO_LLM=1 disables optional summaries and rejects agent mode.
SEO_NO_LLM=
# Tiered models for small gap workers / escalation (defaults to OPENROUTER_MODEL when unset).
OPENROUTER_SMALL_MODEL=
OPENROUTER_MID_MODEL=
# Deployed or preview origin to measure (rendered DOM, raw HTML, links, Lighthouse).
SEO_SITE_URL=
# 1 = provision Playwright/Chromium + Lighthouse in the sandbox and render pages.
SEO_RENDER=
# 1 = install, build and serve the repository inside the sandbox (time-boxed, best effort).
SEO_BUILD=
# 1 = also run the 7 legacy LLM category extractors (default off; the site model covers their data).
SEO_RUN_LLM_AGENTS=
# 1 = run Lighthouse per URL when available; PAGESPEED_API_KEY uses PageSpeed Insights instead for public URLs.
SEO_LIGHTHOUSE=
PAGESPEED_API_KEY=
# Path for a JSONL trace of model calls (tokens, cost, latency).
SEO_TRACE=
# --- Site model orchestrator (seo_reports/site_model) ---
# Max URLs measured (manifest + crawl) and parallel measurement workers.
SEO_MAX_PAGES=200
SEO_MEASURE_WORKERS=4
# Link status checks (internal: all; external: sample size).
SEO_CHECK_LINKS=1
SEO_EXTERNAL_LINK_SAMPLE=50
# Lighthouse runs per form factor (median by LCP) and representative pages per run.
SEO_LIGHTHOUSE_RUNS=3
SEO_LIGHTHOUSE_MAX_PAGES=12
# Cheap-model gap workers (default on when OPENROUTER_API_KEY is set): attribution ties,
# computed metadata, topic/intent, E-E-A-T classification, dynamic instances, unknown-framework adapters.
SEO_GAP_WORKERS=1
SEO_GAP_CONCURRENCY=6
SEO_GAP_MAX_TASKS=200
SEO_TOPIC_MAX_PAGES=40
SEO_EEAT_MAX_PAGES=20
# Gap answers are cached by packet hash (set 0 to disable); learned adapters are cached too.
SEO_GAP_CACHE=
SEO_ADAPTER_CACHE=
# Optional price table for cost logs: {"model": [usd_per_mtok_in, usd_per_mtok_out]}
SEO_MODEL_PRICES=
# --- Legacy LLM category extractors ---
SEO_REPAIR_ROUNDS=4
SEO_MAX_TOOL_CALLS=60
SEO_AGENT_CONCURRENCY=4
